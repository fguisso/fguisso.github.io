---
import Site from '../layouts/Site.astro';
import CornerCard from '../components/CornerCard.astro';
import EditorialCarousel from '../components/EditorialCarousel.astro';
import FeaturedStoryContent from '../components/FeaturedStoryContent.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import LifeBento from '../components/LifeBento.astro';
import LinkPreview from '../components/LinkPreview.astro';
import PostList from '../components/PostList.astro';
import ProjectBoard from '../components/ProjectBoard.astro';
import SocialMarquee from '../components/SocialMarquee.astro';
import { getEditorial } from '../data/editorial';
import { localizedPath } from '../utils/i18n';
import { getPosts, postHref, type PostLanguage } from '../utils/posts';

interface Props { lang?: PostLanguage }
const { lang = 'pt' } = Astro.props;
const english = lang === 'en';
const intro = english
  ? "I'm a software engineer focused on security. I've lived in Natal since 2019, enjoying the sun and the beach."
  : 'Sou um engenheiro de software focado em segurança. Moro em Natal desde 2019, curtindo o sol e a praia.';
const role = english
  ? { lead: "I'm currently", title: 'Head of Information Security', preposition: 'at' }
  : { lead: 'Atualmente sou', title: 'o Head of Information Security', preposition: 'no' };
const background = english
  ? 'I test automations in my homelab, publish tools in open-source Git repositories, and keep notes in my wiki on what I learn about Linux, free software, and music (drums, singing, electric guitar, acoustic guitar).'
  : 'Testo automações no homelab, publico ferramentas em repositórios Git open source e anoto na minha Wiki meus aprendizados com Linux, software livre e música (bateria, canto, guitarra, violão).';
const { gearPreview, lifePreview } = getEditorial(lang);
const posts = await getPosts(lang);
const featured = posts[0];
---

<Site {lang} title={english ? 'Fernando Guisso | Engineering & Security' : 'Fernando Guisso | Engenharia e Segurança'} description={`${intro} ${role.lead} ${role.title} ${role.preposition} Tela.`}>
  <main class="shell alt-home" id="conteudo" tabindex="-1">
    <div class="alt-lead">
      <header class="alt-intro">
        <p class="eyebrow"><span class="signal" aria-hidden="true"></span> {english ? 'A personal corner of the internet' : 'Um canto pessoal da internet'}</p>
        <h1 class="signature text-shimmer">Fernando Guisso</h1>
        <p class="intro-bio">{intro} {role.lead} <em>{role.title}</em> {role.preposition} <LinkPreview href="https://tela.com" image="/preview/tela-home.webp" suffix=".">Tela</LinkPreview></p>
        <p class="intro-bio">{background}</p>
        <div class="alt-intro-links">
          <a href={localizedPath("/about/", lang)}>{english ? "About me" : "Sobre mim"} <span aria-hidden="true">↗</span></a>
          <a class="alt-blog-link" href={localizedPath("/blog/", lang)}>{english ? "Read the articles" : "Ler os artigos"}</a>
        </div>
      </header>
      <HeroCanvas />
    </div>

    <SocialMarquee {lang} />

    <div class="cutout-grid">
      <CornerCard class="alt-posts" label={english ? "Browse all posts" : "Abrir todos os posts"} href={localizedPath("/blog/", lang)}>
        <h2>{english ? "Latest posts" : "Últimos posts"}</h2>
        <PostList {lang} posts={posts.slice(0, 3)} compact />
      </CornerCard>

      <a class="featured-story alt-feature" href={postHref(featured.data.canonicalSlug, lang)}>
        <FeaturedStoryContent post={featured} />
      </a>

      <CornerCard class="alt-gear" label={english ? "Browse Uses" : "Abrir Uses"} href={localizedPath("/gear/", lang)} aria-labelledby="gear-bento-title" mask>
        <EditorialCarousel {lang} id="gear-bento" title="Uses" entries={gearPreview} />
      </CornerCard>

      <LifeBento class="alt-life" {lang} entries={lifePreview} />

      <section class="alt-projects" aria-label={english ? "Projects" : "Projetos"}>
        <ProjectBoard {lang} bento />
      </section>
    </div>
  </main>
</Site>

<style>
  .alt-home { padding-top: 35px; }
  .cutout-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'posts feature gear'
      'life projects projects';
    gap: 16px;
  }
  .alt-lead { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: center; margin-bottom: 24px; }
  .alt-intro .eyebrow { margin-block-end: 12px; }
  .alt-intro h1 { display: block; padding: 0; font-size: clamp(32px, 4.4vw, 56px); }
  .intro-bio { max-width: 46ch; margin: 14px 0 0; color: var(--body); line-height: 1.55; }
  .intro-bio + .intro-bio { margin-top: 10px; }
  .alt-intro-links { display: flex; flex-wrap: wrap; column-gap: 16px; }
  .alt-intro-links a { display: inline-flex; align-items: center; gap: 5px; min-height: 44px; font-size: 13px; }
  .alt-intro-links .alt-blog-link { display: none; color: var(--accent); }
  .alt-lead :global(.hero-canvas) { width: 100%; max-width: 430px; justify-self: center; }
  .alt-posts { grid-area: posts; }
  .alt-feature { grid-area: feature; display: flex; flex-direction: column; min-width: 0; border-radius: 18px; background: none; }
  .alt-gear { grid-area: gear; }
  .cutout-grid > :global(.alt-life) { grid-area: life; }
  .alt-posts h2 { font-size: 18px; margin: 0 0 12px; }
  .alt-projects { grid-area: projects; min-width: 0; }
  .alt-projects :global(.project-board) {
    height: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
  }
  .alt-projects :global(.project-tile) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(14px, 2vw, 22px);
  }
  .alt-projects :global(.dojo-tile) { grid-column: auto; }
  .alt-projects :global(.project-chip) { align-self: start; }
  .alt-projects :global(.project-tile h2) { margin: auto 0 0; }
  .alt-projects :global(.sarif-preview) { padding: 4px 0; }
  .alt-projects :global(.lab-art) { margin: 0; padding: 0; }
  .alt-projects :global(.lab-art > span) { font-size: clamp(22px, 3vw, 38px); }

  @media (max-width: 940px) {
    .cutout-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        'posts posts posts feature feature feature'
        'gear gear gear gear gear gear'
        'life life projects projects projects projects';
    }
  }
  @media (max-width: 760px) {
    .alt-intro-links .alt-blog-link { display: inline-flex; }
  }
  @media (max-width: 620px) {
    .cutout-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'posts' 'feature' 'gear' 'life' 'projects'; }
    .alt-home { padding-top: 28px; }
    .alt-lead { grid-template-columns: minmax(0, 1fr); gap: 8px; margin-bottom: 18px; }
    .alt-lead :global(.hero-canvas) { max-width: 205px; }
  }
  @media (max-width: 420px) {
    .alt-projects :global(.project-board) { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
  }
</style>
