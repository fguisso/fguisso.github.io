---
import { stat } from 'node:fs/promises';
import photoUrl from '../assets/guisso-photo.png?url';
import telaLogo from '../assets/career/tela.svg?url';
import willBankLogo from '../assets/career/will-bank.svg?url';
import globoLogo from '../assets/career/globo.svg?url';
import eflagLogo from '../assets/career/eflag.svg?url';
import hashLogo from '../assets/career/hash.svg?url';
import convisoLogo from '../assets/career/conviso.svg?url';
import decredLogo from '../assets/career/decred.svg?url';
import campusPartyLogo from '../assets/career/campus-party.svg?url';
import mciLogo from '../assets/career/mci.svg?url';
import mantrisLogo from '../assets/career/mantris.svg?url';
import Site from '../layouts/Site.astro';
import AboutPortraits from '../components/AboutPortraits.astro';
import GlowButton from '../components/GlowButton.astro';
import Timeline from '../components/Timeline.astro';

interface Props { lang?: 'pt' | 'en'; }
const { lang = 'pt' } = Astro.props;
const english = lang === 'en';

const photoName = 'fernando-guisso-foto.png';
const photoFile = await stat('src/assets/guisso-photo.png');
const photoKilobytes = Math.round(photoFile.size / 1000);

const bio = english
  ? "Fernando Guisso is Head of Information Security at Tela. His background in AppSec and DevSecOps includes secure development, test automation, and vulnerability analysis at companies such as will bank and Globo. Active in communities like SunsecRN and OWASP, he shares knowledge at events and in open-source projects. In his spare time, he’s learning drums and planning a one-man band."
  : 'Fernando Guisso é Head of Information Security na Tela. Tem experiência em AppSec e DevSecOps, com desenvolvimento seguro, automação de testes e análise de vulnerabilidades em empresas como will bank e Globo. Participa de comunidades como SunsecRN e OWASP, compartilha conhecimento em eventos e projetos open source. Nas horas vagas, estuda bateria e ensaia uma banda de um homem só.';
const timeline = [
  { meta: english ? '2026 - present' : '2026 - atual', companies: [{ name: 'Tela', logo: telaLogo }], role: 'Head of Information Security' },
  { meta: '2024 - 2026', companies: [{ name: 'will bank', logo: willBankLogo }], role: 'Security Software Engineer (AppSec & Sec Eng)' },
  { meta: '2022 - 2024', companies: [{ name: 'Globo', logo: globoLogo }], role: 'Sr. Information Security Analyst' },
  {
    meta: '2019 - 2023',
    companies: [{ name: 'eFlag', logo: eflagLogo }],
    role: english ? 'Strategic Technical Advisor (parallel)' : 'Strategic Technical Advisor (paralelo)',
  },
  { meta: '2021', companies: [{ name: 'Hash', logo: hashLogo }], role: 'Security Software Engineer' },
  { meta: '2020 - 2021', companies: [{ name: 'Conviso', logo: convisoLogo }], role: 'Information Security Analyst' },
  { meta: '2020 - 2021', companies: [{ name: 'Decred', logo: decredLogo }], role: 'Blockchain Software Developer' },
  {
    meta: '2017 - 2019',
    companies: [{ name: 'Campus Party', logo: campusPartyLogo }, { name: 'MCI', logo: mciLogo }],
    role: 'Community Manager / Specialist',
  },
  { meta: '2017', companies: [{ name: 'Mantris', logo: mantrisLogo }], role: 'Full-stack Developer' },
];
---

<Site {lang} title={english ? 'About me' : 'Sobre mim'} description={english ? 'From Mococa to Natal, blending AppSec, DevSecOps, and community work.' : 'De Mococa para Natal, levando AppSec e DevSecOps para times de produto.'}>
  <main class="reading-shell" id="conteudo" tabindex="-1">
    <header class="page-intro about-heading">
      <AboutPortraits {lang} />
      <h1>Fernando <span class="signature">Guisso</span></h1>
    </header>

    <div class="prose">
      <p>{english
        ? "Before the badge came countless events and volunteer projects. Sleepless nights in the hackerspace powered by energy drinks, hot dogs, or pizza. Goroa Hacker Club and Dumont Hackerspace were my school: hours studying and building wild projects with friends."
        : 'Antes do crachá vieram muitos eventos e projetos como voluntário. Noites em claro no hackerspace com energético e cachorro-quente ou pizza. Goroa Hacker Club e Dumont Hackerspace foram minha escola: horas estudando, montando coisas malucas com amigos e conhecendo gente que abriu portas.'}</p>
      <p>{english
        ? "I don’t have a degree (anxiety and traditional classes didn’t click), but I wouldn’t advise skipping it; a diploma would’ve made plenty of moments less painful. I made up for it with obsessive study, personal projects, and a home lab where I break and fix things."
        : 'Não tenho graduação (lido com ansiedade e não me encaixei no ensino tradicional), mas não recomendo pular: o diploma facilitaria muita coisa. Compensei com estudo, projetos, home lab e comunidade.'}</p>
      <p>{english
        ? "Today I’m in AppSec/DevSecOps with the same community vibe: SunsecRN, OWASP, talks, mentoring. I love automation, wiring pipelines, and testing ideas in the lab because learning by doing (and failing, and trying again) is how I roll."
        : 'Hoje sigo em AppSec/DevSecOps com o mesmo espírito: SunsecRN, OWASP, talks e mentoria. Automatizo, monto pipelines e testo ideias no lab; aprender fazendo (e errando) ainda é meu jeito favorito.'}</p>
    </div>

    <section class="about-section" aria-labelledby="bio-title">
      <h2 id="bio-title">{english ? 'Bio to copy' : 'Bio para copiar'}</h2>
      <div class="bio-box">
        <textarea id="bio-text" aria-labelledby="bio-title" readonly rows="7">{bio}</textarea>
        <div class="bio-controls" data-bio-controls hidden>
          <p data-copy-status data-copied={english ? 'Bio copied.' : 'Bio copiada.'}
            data-selected={english ? 'Text selected. Use the Copy command.' : 'Texto selecionado. Use o comando Copiar.'} role="status"></p>
          <GlowButton variant="outline" size="sm" class="copy-bio" data-copy-bio data-tianji-event={`copy_bio_text_${lang}`}>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="8" y="8" width="12" height="12" rx="2" />
              <path d="M4 15V6a2 2 0 0 1 2-2h9" />
            </svg>
            {english ? 'Copy bio' : 'Copiar bio'}
          </GlowButton>
        </div>
      </div>
      <div class="bio-download">
        <GlowButton href={photoUrl} variant="outline" download={photoName} data-tianji-event={`download_bio_photo_${lang}`}>{english ? 'Download photo' : 'Baixar foto'} (PNG, {photoKilobytes} kB)</GlowButton>
      </div>
    </section>

    <section class="about-section" aria-labelledby="timeline-title">
      <h2 id="timeline-title">{english ? 'Timeline' : 'Linha do tempo'}</h2>
      <Timeline items={timeline} />
    </section>
  </main>
</Site>

<script>
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-bio]');
  const bio = document.querySelector<HTMLTextAreaElement>('#bio-text');
  const controls = document.querySelector<HTMLElement>('[data-bio-controls]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (copy && bio && controls && status) {
    controls.hidden = false;
    copy.addEventListener('click', async () => {
      status.textContent = '';
      status.removeAttribute('data-success');
      try {
        await navigator.clipboard.writeText(bio.value);
        status.textContent = status.dataset.copied ?? '';
        status.setAttribute('data-success', '');
      } catch {
        bio.focus();
        bio.select();
        status.textContent = status.dataset.selected ?? '';
      }
    });
  }
</script>

<style>
  .about-heading { margin-bottom: 24px; }
  .about-heading h1 { margin-top: 22px; }
  .about-section { margin-top: calc(var(--section-gap) + 8px); }
  .about-section h2 { font-size: 24px; margin-bottom: 14px; }
  .bio-box { border: 1px solid var(--line); border-radius: 14px; background: var(--panel); }
  textarea {
    display: block;
    width: 100%;
    min-height: 9rem;
    padding: 14px 16px;
    border: 0;
    border-radius: 13px;
    background: transparent;
    color: var(--ink);
    font: 16px/1.6 var(--sans);
    resize: vertical;
  }
  .bio-controls { display: flex; justify-content: flex-end; align-items: center; gap: 12px; padding: 4px 12px 12px; }
  .bio-controls p { margin: 0; color: var(--muted-on-panel, var(--muted)); font-size: var(--text-caption); }
  .bio-controls p[data-success] { color: var(--accent); }
  .bio-controls :global(.copy-bio) { flex: none; gap: 6px; }
  .bio-download { margin-top: 12px; }
</style>
