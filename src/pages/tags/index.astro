---
import Site from '../../layouts/Site.astro';
import ListSearch from '../../components/ListSearch.astro';
import { getPosts, postTagHref, type PostLanguage } from '../../utils/posts';
import { normalizeSearchText } from '../../utils/search-text';

interface Props { lang?: PostLanguage }
const { lang = 'pt' } = Astro.props;
const english = lang === 'en';
const topics = new Map<string, { label: string; posts: Set<string> }>();
for (const post of await getPosts(lang)) {
  for (const label of post.data.tags) {
    const key = normalizeSearchText(label);
    const topic = topics.get(key) ?? { label, posts: new Set<string>() };
    topic.posts.add(post.id);
    topics.set(key, topic);
  }
}
const tags = [...topics.values()].sort((first, second) => first.label.localeCompare(second.label, english ? 'en' : 'pt-BR'));
const description = english ? 'Choose a topic to see the articles tagged with it.' : 'Escolha um assunto para ver os artigos marcados com ele.';
---
<Site title="Tags" {description} {lang}>
  <main class="shell page-content" data-topic-list id="conteudo" tabindex="-1">
    <header class="page-intro">
      <h1>{english ? 'One topic' : 'Um assunto'}<br /><span class="signature">{english ? 'leads to another.' : 'puxa outro.'}</span></h1>
      <p class="lead">{description}</p>
    </header>
    <ListSearch id="topic-query" count={tags.length} label={english ? 'Search topics' : 'Buscar assuntos'} placeholder={english ? 'Topic name…' : 'Nome do assunto…'}
      clearLabel={english ? 'Clear search' : 'Limpar busca'} singular={english ? 'topic' : 'assunto'} plural={english ? 'topics' : 'assuntos'} />
    <ul class="topic-list" role="list">
      {tags.map(({ label, posts }) => (
        <li data-topic data-search={label}>
          <a href={postTagHref(label, lang)}>
            <span>#{label}</span>
            <span>{posts.size} {posts.size === 1 ? (english ? 'article' : 'artigo') : (english ? 'articles' : 'artigos')} <span aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ul>
    <p data-search-empty hidden>{english ? 'No topics found. Try another search.' : 'Nenhum assunto encontrado. Tente outro termo.'}</p>
  </main>
</Site>
