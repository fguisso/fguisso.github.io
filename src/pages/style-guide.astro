---
import Site from '../layouts/Site.astro';
import '../styles/style-guide.css';
import AboutPortraits from '../components/AboutPortraits.astro';
import ArticleHeaderExamples from '../components/ArticleHeaderExamples.astro';
import OpenGraphExamples from '../components/OpenGraphExamples.astro';
import { articleOgInset } from '../lib/social-card';
import { asciiBackgroundScene, renderAsciiBackground } from '../lib/ascii-background';
import '../styles/article-title.css';
import Breakdown from '../components/Breakdown.astro';
import Callout from '../components/Callout.astro';
import Chip from '../components/Chip.astro';
import CornerCard from '../components/CornerCard.astro';
import DiffBlock from '../components/DiffBlock.astro';
import DiffLine from '../components/DiffLine.astro';
import EditorialCarousel from '../components/EditorialCarousel.astro';
import FeaturedStoryContent from '../components/FeaturedStoryContent.astro';
import GlowBox from '../components/GlowBox.astro';
import GlowButton from '../components/GlowButton.astro';
import LifeBento from '../components/LifeBento.astro';
import LogoWordmark from '../components/LogoWordmark.astro';
import NavIcon from '../components/NavIcon.astro';
import OwaspTop10Evolution from '../components/OwaspTop10Evolution.astro';
import OwaspPill from '../components/OwaspPill.astro';
import PostList from '../components/PostList.astro';
import ProjectBoard from '../components/ProjectBoard.astro';
import RedirectValidationDemo from '../components/RedirectValidationDemo.astro';
import TalkAvatarBadge from '../components/TalkAvatarBadge.astro';
import Timeline from '../components/Timeline.astro';
import { getEditorial } from '../data/editorial';
import { localizedPath } from '../utils/i18n';
import { withBase } from '../utils/paths';
import { socials } from '../data/socials';
import { getPosts, postHref } from '../utils/posts';

interface Props { lang?: 'pt' | 'en'; }
const { lang = 'pt' } = Astro.props;
const t = (pt: string, en: string) => lang === 'en' ? en : pt;
const { gearPreview, lifePreview } = getEditorial(lang);
const posts = await getPosts(lang);
const featured = posts[0];
const asciiSamples = await Promise.all(([
  { label: t('Uma forma · círculo', 'One shape · circle'), composition: [0, 1], tone: 'green' },
  { label: t('Duas formas · triângulos', 'Two shapes · triangles'), composition: [2, 0], tone: 'purple' },
  { label: t('Três formas · círculos e triângulo', 'Three shapes · circles and triangle'), composition: [1, 2], tone: 'green' },
] as const).map(async ({ label, composition, tone }) => {
  const scene = asciiBackgroundScene(composition.join(':'), composition);
  return { label, tone, ascii: await renderAsciiBackground(scene.shapes) };
}));
const github = socials[0];
const palette = [
  { name: t('Fundo', 'Background'), token: '--page' },
  { name: t('Painel', 'Panel'), token: '--panel' },
  { name: t('Controle', 'Control'), token: '--area' },
  { name: t('Borda', 'Border'), token: '--line' },
  { name: t('Título', 'Heading'), token: '--ink' },
  { name: t('Texto', 'Body text'), token: '--body' },
  { name: t('Texto auxiliar', 'Secondary text'), token: '--muted' },
  { name: t('Verde', 'Green'), token: '--accent' },
  { name: t('Roxo', 'Purple'), token: '--secondary' },
];
const buttons = [
  { variant: 'primary', label: t('Padrão', 'Default') },
  { variant: 'accent', label: t('Destaque', 'Accent') },
  { variant: 'secondary', label: t('Secundário', 'Secondary') },
  { variant: 'outline', label: t('Contorno', 'Outline') },
  { variant: 'ghost', label: t('Discreto', 'Subtle') },
] as const;
const callouts = [
  { variant: 'info', title: t('Nota', 'Note'), text: t('Um detalhe que ajuda a acompanhar o exemplo.', 'A detail to help you follow the example.') },
  { variant: 'success', title: t('Validado', 'Validated'), text: t('O destino atende à regra de domínio.', 'The destination meets the domain requirement.') },
  { variant: 'warning', title: t('Atenção', 'Caution'), text: t('Revise as condições antes de continuar.', 'Review the conditions before continuing.') },
  { variant: 'danger', title: t('Bloqueado', 'Blocked'), text: t('O domínio de destino está fora da lista permitida.', 'The destination domain is outside the allowlist.') },
] as const;
const contents = [
  { id: 'cores-laboratorio', name: t('Cores e tipo', 'Color and type') },
  { id: 'componentes', name: t('Controles', 'Controls') },
  { id: 'post-cards', name: 'Bento' },
  { id: 'post-meta-inline', name: t('Cabeçalhos de artigo', 'Article headers') },
  { id: 'open-graph', name: 'Open Graph' },
  { id: 'ascii-backgrounds', name: t('Fundos ASCII Art', 'ASCII art backgrounds') },
  { id: 'logo', name: t('Identidade', 'Identity') },
  { id: 'layouts', name: t('Blocos de artigo', 'Article blocks') },
  { id: 'owasp-top10-evolution', name: t('Interativos', 'Interactive examples') },
];
---

<Site {lang} title="Style guide" description={t('Cores, tipografia e componentes do blog de Fernando Guisso.', 'Colors, typography, and components from Fernando Guisso’s blog.')}>
  <main class="shell style-guide-shell" id="conteudo" tabindex="-1">
    <header class="guide-intro">
      <h1>Style guide</h1>
      <p class="lead">{t('Cores, tipografia e componentes da home e dos artigos.', 'Colors, typography, and components used on the home page and in articles.')}</p>
      <nav class="guide-links" aria-label={t('Seções do style guide', 'Style guide sections')}>
        {contents.map(({ id, name }) => <a href={'#' + id}>{name}</a>)}
      </nav>
    </header>

    <section class="guide-section" id="cores-laboratorio" aria-labelledby="cores">
      <h2 id="cores">{t('Paleta', 'Palette')}</h2>
      <p>{t('Os mesmos tokens da home respondem aos temas Escuro, Claro e Areia no menu Mais.', 'These are the home page’s color tokens. Switch between Dark, Light, and Sand in the More menu to see them change.')}</p>
      <ul class="guide-palette">
        {palette.map(({ name, token }) => (
          <li>
            <span class="guide-swatch" style={`background:var(${token})`} aria-hidden="true"></span>
            <span>{name}</span>
            <code>{token}</code>
          </li>
        ))}
      </ul>
    </section>

    <section class="guide-section" id="tipografia">
      <h2>{t('Tipografia', 'Typography')}</h2>
      <p>{t('Inter na interface e na leitura. Georgia nas capas e destaques editoriais.', 'Inter is used for the interface and article text. Covers and editorial highlights use Georgia.')}</p>
      <GlowBox class="guide-type">
        <div><p class="guide-type-title">{t('Engenharia e segurança', 'Engineering and security')}</p><small>{t('Inter · Título de página', 'Inter · Page title')}</small></div>
        <div><p class="guide-type-heading">{t('Segurança perto do código', 'Security close to the code')}</p><small>{t('Inter · Título de seção', 'Inter · Section heading')}</small></div>
        <div><p class="guide-type-subheading">{t('O que mudou', 'What changed')}</p><small>{t('Inter · Subtítulo', 'Inter · Subheading')}</small></div>
        <div><p>{t('Crio ferramentas e compartilho o que aprendo.', 'I build tools and share what I learn.')}</p><small>{t('Inter · Texto corrente', 'Inter · Body text')}</small></div>
        <div><p class="guide-type-editorial">{t('Aprender fazendo.', 'Learning by doing.')}</p><small>{t('Georgia · Destaque editorial', 'Georgia · Editorial highlight')}</small></div>
      </GlowBox>
      <div id="eyebrows" class="guide-eyebrows">
        <div><p class="eyebrow"><span class="signal" aria-hidden="true"></span> {t('Engenharia / Segurança', 'Engineering / Security')}</p><small>{t('Abertura editorial', 'Editorial introduction')}</small></div>
        <div><p class="eyebrow">{t('Componentes', 'Components')}</p><small>{t('Contexto de seção', 'Section context')}</small></div>
        <div><p class="eyebrow">{t('Notas de campo', 'Field notes')}</p><small>{t('Tema do artigo', 'Article topic')}</small></div>
      </div>
    </section>

    <section class="guide-section" id="componentes">
      <h2>{t('Botões e estados', 'Buttons and states')}</h2>
      <div class="guide-controls">
        {buttons.map(({ variant, label }) => <GlowButton variant={variant}>{label}</GlowButton>)}
        <GlowButton disabled>{t('Indisponível', 'Unavailable')}</GlowButton>
      </div>
      <div class="guide-controls">
        <GlowButton size="sm" variant="outline">{t('Compacto', 'Compact')}</GlowButton>
        <GlowButton size="md" variant="primary">{t('Padrão', 'Default')}</GlowButton>
        <GlowButton size="lg" variant="accent">{t('Amplo', 'Large')}</GlowButton>
      </div>
    </section>

    <section class="guide-section" id="utility-buttons">
      <h2>{t('Controles utilitários', 'Utility controls')}</h2>
      <p>{t('As setas dos carrosséis voltam um item por vez. Os atalhos de navegação combinam ícones e rótulos acessíveis.', 'The carousel arrows move one item at a time. Navigation shortcuts pair icons with accessible labels.')}</p>
      <div class="guide-controls">
        <a class="guide-icon-control" href={github.href} aria-label={github.label}>
          <svg width="18" height="18" viewBox={github.viewBox} fill="currentColor" aria-hidden="true"><path d={github.path} /></svg>
        </a>
        <a class="guide-icon-control" href={localizedPath('/blog/', lang)} aria-label="Blog"><NavIcon name="blog" /></a>
        <a class="guide-icon-control" href={localizedPath('/projects/', lang)} aria-label={t('Projetos', 'Projects')}><NavIcon name="projects" /></a>
        <details class="guide-utility">
          <summary class="guide-icon-control" aria-label={t('Mais opções', 'More options')}><NavIcon name="more" /></summary>
          <a href={localizedPath('/about/', lang)}>{t('Sobre', 'About')}</a>
        </details>
        <details class="guide-utility">
          <summary class="guide-icon-control" aria-label={t('Abrir menu compacto', 'Open compact menu')}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
          </summary>
          <a href={localizedPath('/talk/', lang)}>Talks</a>
        </details>
      </div>
    </section>

    <section class="guide-section" id="chips">
      <h2>{t('Chips e marcadores', 'Chips and badges')}</h2>
      <p>{t('O contorno identifica assuntos e projetos. A versão sólida destaca categorias sobre imagens.', 'Outlined chips identify topics and projects. Solid chips mark categories on images.')}</p>
      <div class="guide-controls">
        <Chip>{t('Projeto', 'Project')}</Chip><Chip>AppSec</Chip><Chip variant="solid">Life</Chip>
      </div>
      <div id="pills" class="guide-controls">
        <span class="guide-pill">{t('Base', 'Default')}</span>
        <span class="guide-pill guide-pill--warning">{t('Atenção', 'Caution')}</span>
        <span class="guide-pill guide-pill--danger">{t('Risco', 'Risk')}</span>
        <OwaspPill>A03:2025</OwaspPill>
        <span class="guide-pill guide-pill--success">{t('Novo', 'New')}</span>
        <span class="guide-pill guide-pill--secondary">{t('Categoria', 'Category')}</span>
      </div>
    </section>

    <section class="guide-section" id="post-cards">
      <h2>{t('Posts na home', 'Posts on the home page')}</h2>
      <p>{t('A lista usa o recorte de canto para abrir o acervo. O destaque inteiro abre o artigo.', 'The corner link opens the archive. The entire featured card opens its article.')}</p>
      <div class="guide-bento">
        <CornerCard href={localizedPath('/blog/', lang)} label={t('Abrir todos os posts', 'View all posts')} class="guide-latest">
          <h3>{t('Últimos posts', 'Latest posts')}</h3>
          <PostList {lang} posts={posts.slice(0, 3)} compact />
        </CornerCard>
        <a class="featured-story guide-featured" href={postHref(featured.data.canonicalSlug, lang)}>
          <FeaturedStoryContent post={featured} />
        </a>
      </div>
    </section>

    <section class="guide-section" id="editorial-cards">
      <h2>{t('Uses e Life', 'Uses and Life')}</h2>
      <p>{t('Em Uses, a legenda fica abaixo da miniatura. Life usa o mesmo Bento da home, com fotos em tela cheia que alternam a cada oito segundos.', 'Uses puts its caption below the thumbnail. Life uses the same Bento as the home page, with full-bleed photos that advance every eight seconds.')}</p>
      <div class="guide-bento guide-editorial">
        <CornerCard href={localizedPath('/gear/', lang)} label={t('Abrir Uses', 'Open Uses')} aria-labelledby="gear-guide-title" mask>
          <EditorialCarousel {lang} id="gear-guide" title="Uses" entries={gearPreview} />
        </CornerCard>
        <LifeBento {lang} id="life-guide" entries={lifePreview} />
      </div>
    </section>

    <section class="guide-section" id="cards">
      <h2>{t('Projetos', 'Projects')}</h2>
      <p>{t('Homelab e Dojo Shield usam o mesmo gerador de círculos e triângulos em ASCII dos artigos. Homelab usa roxo com verde, e Dojo Shield inverte a combinação.', 'Homelab and Dojo Shield use the same ASCII circle and triangle generator as the articles. Homelab uses purple with green accents, and Dojo Shield reverses the colors.')}</p>
      <ProjectBoard {lang} bento />
    </section>

    <section class="guide-section" id="post-meta-inline">
      <h2>{t('Cabeçalhos de artigo', 'Article headers')}</h2>
      <ArticleHeaderExamples {lang} {posts} />
    </section>

    <section class="guide-section" id="open-graph">
      <h2>{t('Cards Open Graph', 'Open Graph cards')}</h2>
      <p>{t(`O build gera PNGs de 1200 × 630 para compartilhar artigos. O fundo da imagem fica visível em uma margem de ${articleOgInset} px nos quatro lados do Bento. A marca ocupa o recorte superior esquerdo e o avatar fica no inferior direito.`, `The build generates 1200 × 630 PNGs for sharing articles. A ${articleOgInset} px margin of the image background surrounds the Bento on all four sides. The wordmark sits in the upper-left cutout and the avatar in the lower-right one.`)}</p>
      <OpenGraphExamples {lang} {posts} />
    </section>

    <section class="guide-section" id="ascii-backgrounds">
      <h2>{t('Fundos ASCII Art', 'ASCII art backgrounds')}</h2>
      <p>{t('Nos artigos, o título determina a cena e a cor. O gerador traduz o preenchimento em caracteres: do espaço vazio até @, numa grade de 60 colunas por 18 linhas.', 'In articles, the title determines the scene and color. The renderer turns coverage into characters, from an empty space to @, on a grid of 60 columns by 18 rows.')}</p>
      <ul class="guide-ascii-samples" role="list">
        {asciiSamples.map(({ label, tone, ascii }) => (
          <li>
            <figure>
              <div class="guide-ascii-sample article-art-palette" data-tone={tone} data-surface="bento" aria-hidden="true">
                <pre class="article-ascii-glyphs" set:text={ascii} />
              </div>
              <figcaption>{label}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <dl class="guide-ascii-rules">
        <dt>{t('Formas e cor', 'Shapes and color')}</dt>
        <dd>{t('Use de uma a três formas, entre círculos e triângulos. Com três, misture as duas. O destaque é verde ou roxo; no cabeçalho simples, os acentos acompanham o tema. O Bento usa sua própria paleta escura.', 'Use one to three circles or triangles. With three, mix both shapes. The accent is green or purple; plain headings follow the active theme, while Bento uses its own dark palette.')}</dd>
        <dt>{t('Zoom e leitura', 'Zoom and readability')}</dt>
        <dd>{t('Experimente zoom e enquadramento sem encobrir o texto. Mantenha a arte à direita e use um degradê para suavizá-la perto do título. Nos cabeçalhos, a arte fica mais discreta em telas estreitas; o PNG tem composição fixa.', 'Try different zoom levels and framing without obscuring the text. Keep the art on the right and fade it toward the heading. Article headers soften the art on narrow screens; the PNG has a fixed composition.')}</dd>
        <dt>{t('Movimento', 'Motion')}</dt>
        <dd>{t('Os fundos de artigo e Open Graph são estáticos. A cena 3D da home é outro gerador: respeita a preferência por movimento reduzido e tem SVG estático de fallback para cada tema.', 'Article and Open Graph backgrounds are static. The 3D home scene uses a separate renderer: it respects reduced motion and has a static SVG fallback for each theme.')}</dd>
      </dl>
    </section>

    <section class="guide-section" id="logo">
      <h2>{t('Marca', 'Brand')}</h2>
      <p>{t('A marca completa de 80 px e o G de 20 px usam o mesmo desenho inicial e o mesmo triângulo.', 'The 80 px wordmark and 20 px G share the same initial and triangle.')}</p>
      <div class="guide-bento">
        <div class="guide-logo guide-logo--dark"><LogoWordmark width={80} height={31} /><LogoWordmark monogram /><small>{t('Fundo escuro', 'Dark background')}</small></div>
        <div class="guide-logo guide-logo--light"><LogoWordmark width={80} height={31} /><LogoWordmark monogram /><small>{t('Fundo claro', 'Light background')}</small></div>
      </div>
      <div class="guide-controls">
        <GlowButton href={withBase('/style-guide/logo-wordmark.png')} variant="outline" size="sm">{t('PNG para fundo escuro', 'PNG for dark backgrounds')}</GlowButton>
        <GlowButton href={withBase('/style-guide/logo-wordmark-dark.png')} variant="outline" size="sm">{t('PNG para fundo claro', 'PNG for light backgrounds')}</GlowButton>
      </div>
      <div class="guide-signatures" aria-label={t('Variações para microsites', 'Microsite variants')}>
        <a href="https://wiki.guisso.dev/"><span class="microsite-mark" style={`--mark: url('${withBase('/style-guide/gwiki.svg')}')`} aria-hidden="true"></span><small>wiki.guisso.dev</small></a>
        <a href="https://guisso.dev/gtuner/"><span class="microsite-mark" style={`--mark: url('${withBase('/style-guide/gtuner.svg')}')`} aria-hidden="true"></span><small>guisso.dev/gtuner</small></a>
      </div>
    </section>

    <section class="guide-section" id="gradientes">
      <h2>{t('Assinatura e brilho', 'Signature and shimmer')}</h2>
      <p>{t('A assinatura tem verde sólido e usa o mesmo efeito de luz da home.', 'The signature is solid green and uses the same shimmer as the home page.')}</p>
      <p class="guide-signature"><span class="signature text-shimmer">Fernando Guisso<span class="signature-dot">.</span></span></p>
    </section>

    <section class="guide-section" id="avatar">
      <h2>{t('Foto e avatar', 'Photo and avatar')}</h2>
      <p>{t('A pessoa e o cenário aparecem em ASCII, com transparência entre os caracteres. Passe o mouse ou toque para ver a foto original. O avatar começa como imagem e alterna para ASCII.', 'The person and surroundings appear in ASCII, with transparency between the characters. Hover or tap to see the original photo. The avatar starts as an image and switches to ASCII.')}</p>
      <AboutPortraits {lang} />
      <div class="guide-talk-badge">
        <TalkAvatarBadge variant="corner" />
        <div><h3>TalkAvatarBadge</h3><p>{t('O avatar circular fica fixo. Passe o mouse para revelar a foto ao lado.', 'The circular avatar stays in place. Hover to reveal the photo beside it.')}</p></div>
      </div>
    </section>

    <section class="guide-section" id="layouts">
      <h2>{t('Painéis e notas', 'Panels and notes')}</h2>
      <p>{t('GlowBox usa uma borda simples para agrupar conteúdo. Callout usa cor para distinguir o tipo de mensagem.', 'GlowBox groups content inside a single border. Callout uses color to distinguish message types.')}</p>
      <div class="guide-bento">
        <GlowBox padding="snug" accent="accent"><h3>{t('Painel compacto', 'Compact panel')}</h3><p>{t('Para exemplos curtos e controles relacionados.', 'For short examples and related controls.')}</p></GlowBox>
        <GlowBox padding="relaxed" accent="secondary"><h3>{t('Painel amplo', 'Spacious panel')}</h3><p>{t('Para amostras de leitura que precisam de mais espaço.', 'For reading samples that need more space.')}</p></GlowBox>
        {callouts.map(({ variant, title, text }) => (
          <Callout {variant} {title}>
            {variant === 'warning' && (
              <svg slot="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4 2 21h20L12 4ZM12 10v4m0 3h.01" />
              </svg>
            )}
            <p>{text}</p>
          </Callout>
        ))}
      </div>
    </section>

    <section class="guide-section" id="timeline">
      <h2>{t('Linha do tempo', 'Timeline')}</h2>
      <p>{t('Datas e descrições alinhadas a uma linha com marcadores discretos.', 'Dates and descriptions line up along a timeline with subtle markers.')}</p>
      <Timeline items={[
        { meta: '2024', role: 'will bank · Security Software Engineer (AppSec & Sec Eng)' },
        { meta: t('2022 a 2024', '2022 to 2024'), role: t('Globo · Prática de segurança para times grandes', 'Globo · Security practices for large teams') },
        { meta: t('2017 a 2019', '2017 to 2019'), role: t('Comunidades · Goroa e Dumont Hackerspace', 'Communities · Goroa and Dumont Hackerspace') },
      ]} />
    </section>

    <section class="guide-section" id="owasp-post-components">
      <h2>{t('Categorias do OWASP', 'OWASP categories')}</h2>
      <GlowBox>
        <h3 class="guide-category"><OwaspPill>A03</OwaspPill> Software Supply Chain Failures <OwaspPill variant="new">{t('Novo', 'New')}</OwaspPill></h3>
        <p><OwaspPill>A03:2025</OwaspPill> {t('A categoria amplia a análise de componentes vulneráveis para a cadeia de software.', 'This category extends the scope from vulnerable components to the software supply chain.')}</p>
        <p><OwaspPill>A02:2025</OwaspPill> {t('Security Misconfiguration passou para a segunda posição.', 'Security Misconfiguration moved up to second place.')}</p>
      </GlowBox>
    </section>

    <section class="guide-section" id="owasp-top10-evolution">
      <h2>{t('Evolução do OWASP Top 10', 'Changes in the OWASP Top 10')}</h2>
      <p>{t('Acione o controle para acompanhar as conexões entre as edições de 2021 e 2025.', 'Use the control to see how the categories connect across the 2021 and 2025 editions.')}</p>
      <OwaspTop10Evolution locale={lang} />
    </section>

    <section class="guide-section" id="diff-block">
      <h2>{t('Diff anotado', 'Annotated diff')}</h2>
      <p>{t('Selecione uma linha marcada com um ponto para abrir sua anotação.', 'Select a line marked with a dot to open its annotation.')}</p>
      <DiffBlock {lang} filename={t('exemplo/format-date.js', 'example/format-date.js')} tag={t('corrigido', 'fixed')} tagVariant="success">
        <DiffLine {lang} num="1" type="context" code="export function formatDate(date) {" />
        <DiffLine {lang} num="2" type="remove" code={`  return date.toLocaleDateString('${t('pt-BR', 'en-US')}');`} annotation={t('Antes, a data dependia do fuso horário do navegador.', 'Previously, the date depended on the browser’s time zone.')} />
        <DiffLine {lang} num="2" type="add" code={`  return date.toLocaleDateString('${t('pt-BR', 'en-US')}', { timeZone: 'UTC' });`} annotation={t('Com UTC, uma mesma data aparece em todos os fusos.', 'Using UTC displays the same date in every time zone.')} />
        <DiffLine {lang} num="3" type="context" code="}" />
      </DiffBlock>
      <details class="guide-component-notes">
        <summary>{t('Propriedades do componente', 'Component properties')}</summary>
        {lang === 'en' ? (
          <p><code>DiffBlock</code> accepts <code>filename</code>, <code>tag</code>, and <code>tagVariant</code>. Each <code>DiffLine</code> takes <code>num</code>, <code>type</code>, and <code>code</code>. Use <code>annotation</code> to add an expandable explanation.</p>
        ) : (
          <p><code>DiffBlock</code> recebe <code>filename</code>, <code>tag</code> e <code>tagVariant</code>. Cada <code>DiffLine</code> recebe <code>num</code>, <code>type</code> e <code>code</code>. Use <code>annotation</code> para adicionar uma explicação expansível.</p>
        )}
      </details>
    </section>

    <section class="guide-section" id="breakdown">
      <h2>{t('Anatomia de URL e comando', 'Anatomy of a URL and a command')}</h2>
