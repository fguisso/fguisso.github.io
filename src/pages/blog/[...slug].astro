---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import InteractivePost from '../../layouts/InteractivePost.astro';
import { getPostPaths, readingMinutes } from '../../utils/posts';

export function getStaticPaths() {
  return getPostPaths('pt');
}

const { post, hasTranslation } = Astro.props;
const { Content, headings } = await render(post);
---

{post.data.customTemplate === 'interactive' ? (
  <InteractivePost {post} {hasTranslation}><Content /></InteractivePost>
) : (
  <BlogPost {post} {headings} {hasTranslation} readingTimeMinutes={readingMinutes(post.body)}><Content /></BlogPost>
)}
