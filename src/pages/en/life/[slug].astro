---
import EditorialItem from '../../../layouts/EditorialItem.astro';
import { getLife } from '../../../data/life';

export function getStaticPaths() {
  return getLife('en').map(item => ({ params: { slug: item.slug }, props: { item } }));
}
---
<EditorialItem item={Astro.props.item} section="Life" lang="en" />
