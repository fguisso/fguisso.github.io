---
import EditorialItem from '../../../layouts/EditorialItem.astro';
import { getGear } from '../../../data/gear';

export function getStaticPaths() {
  return getGear('en').map(item => ({ params: { slug: item.slug }, props: { item } }));
}
---
<EditorialItem item={Astro.props.item} section="Gear" lang="en" />
