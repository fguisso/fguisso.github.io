---
import Site from '../layouts/Site.astro';
import Chip from '../components/Chip.astro';
import GlowBox from '../components/GlowBox.astro';
import GlowButton from '../components/GlowButton.astro';
import TalkAvatarBadge from '../components/TalkAvatarBadge.astro';
import { getTalkPage } from '../data/talks';
import { formatDate, getPosts, postHref, readingMinutes, wordCount } from '../utils/posts';
import { slugifyTag } from '../utils/tags';

interface Props { lang?: 'pt' | 'en'; }
const { lang = 'pt' } = Astro.props;
const english = lang === 'en';
const { repoCard, repoHighlights, talks, standaloneSlides } = getTalkPage(lang);
const posts = new Map((await getPosts(lang)).map(post => [post.data.canonicalSlug, post]));
const presentations = talks.map(talk => ({
  ...talk,
  article: talk.articleSlug ? posts.get(talk.articleSlug) : undefined,
}));
---

<Site {lang} title={english ? 'Talks' : 'Palestras'} description={english ? 'Slides, recordings, and articles from my talks on AppSec, homelabs, eBPF, and automation.' : 'Slides, gravações e artigos das minhas palestras sobre AppSec, homelab, eBPF e automação.'}>
  <main class="shell page-content talks-page" id="conteudo" tabindex="-1">
    <header class="talk-intro">
      <div>
        <h1>{english ? 'Joined one of my talks? All' : 'Foi em alguma talk minha? Os'} <span class="signature">slides</span> {english ? 'are right here.' : 'estão aqui.'}</h1>
        <p>{english ? 'I build my newer decks in' : 'Monto os slides mais recentes em'} <a href="https://sli.dev/" data-tianji-event={`outbound_link_${lang}`}>Slidev</a>{english ? ', keep the source in Markdown, and publish automatically with GitHub Actions.' : ', versiono em Markdown e publico automaticamente via GitHub Actions.'}</p>
        <p>{english ? 'Some talks became articles with code, references, and further reading.' : 'Algumas talks também viraram posts com código, referências e material para continuar a leitura.'}</p>
        <div class="talk-profile">
          <TalkAvatarBadge />
          <div><strong>Fernando Guisso</strong><p>{english ? 'Sharing and learning, hack the planet!' : 'Compartilhando e aprendendo, hack the planet!'}</p></div>
        </div>
      </div>
      <GlowBox class="talk-repo">
        <h2>{repoCard.title}</h2>
        <p>{repoCard.description}</p>
        <ul>{repoHighlights.map((item) => <li>{item}</li>)}</ul>
        <GlowButton href={repoCard.url} variant="outline" data-tianji-event={`click_talk_repo_${slugifyTag(repoCard.title)}`}>{english ? 'View repository' : 'Ver repositório'}</GlowButton>
      </GlowBox>
    </header>

    <section id="agenda" class="talk-agenda" aria-labelledby="agenda-title">
      <h2 id="agenda-title">{english ? 'Talks and related materials' : 'Palestras e materiais'}</h2>
      <ol class="talk-timeline" role="list">
        {presentations.map((talk, index) => (
          <li>
            <GlowBox class="talk-entry">
              <div class="talk-entry-heading">
                <div><p class="talk-event">{talk.event}</p><h3 id={`talk-title-${index}`}>{talk.talkTitle}</h3></div>
                <Chip>{talk.tag}</Chip>
              </div>
              {talk.summary && <p>{talk.summary}</p>}
              {talk.article && (
                <a class="talk-article" href={postHref(talk.article.data.canonicalSlug, lang)} data-tianji-event={`click_talk_resource_${slugifyTag(talk.talkTitle)}_article`}>
                  <span>{english ? 'Related article' : 'Post relacionado'}</span>
                  <strong>{talk.article.data.title}</strong>
                  <small>{formatDate(talk.article.data.pubDate, lang)} · {wordCount(talk.article.body)} {english ? 'words' : 'palavras'} · {readingMinutes(talk.article.body)} min</small>
                  <span class="talk-article-arrow" aria-hidden="true">→</span>
                </a>
              )}
              <div class="talk-actions">
                {talk.video && (
                  <GlowButton href={talk.video.url} variant="secondary" id={`talk-video-${index}`} aria-labelledby={`talk-video-${index} talk-title-${index}`} data-tianji-event={`click_talk_resource_${slugifyTag(talk.talkTitle)}_video`}>
                    {talk.video.label}
                  </GlowButton>
                )}
                {talk.slides && (
                  <GlowButton href={talk.slides.url} variant="outline" id={`talk-slides-${index}`} aria-labelledby={`talk-slides-${index} talk-title-${index}`} data-tianji-event={`click_talk_resource_${slugifyTag(talk.talkTitle)}_slides`}>
                    {talk.slides.label}
                  </GlowButton>
                )}
              </div>
            </GlowBox>
          </li>
        ))}
      </ol>
    </section>

    <section id="slides" class="talk-archive" aria-labelledby="slides-title">
      <h2 id="slides-title">{english ? 'Standalone slides' : 'Slides avulsos'}</h2>
      <p>{english ? 'Decks in Portuguese without a confirmed event or presentation date.' : 'Apresentações sem evento ou data de apresentação confirmados.'}</p>
      <ul role="list">
        {standaloneSlides.map(slide => (
          <li>
            <a href={slide.url} data-tianji-event={`click_talk_resource_${slugifyTag(slide.label)}_slides`}>
              {slide.label}<span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Site>

<style>
  .talk-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    margin-bottom: calc(var(--section-gap) + 8px);
  }
  .talk-intro h1 { font-size: clamp(34px, 5vw, 54px); margin-bottom: 20px; }
  .talk-intro p { margin-bottom: 12px; }
  .talk-profile { display: flex; gap: 12px; align-items: center; margin-top: 20px; }
  .talk-profile p { margin: 0; font-size: 13px; }
  .talk-repo h2 { margin-bottom: 10px; }
  .talk-repo ul { margin: 0 0 18px; padding-inline-start: 1.2em; list-style: disc; font-size: 14px; }
  .talk-repo li::marker { color: var(--accent); }
  :is(.talk-agenda, .talk-archive) > h2 { font-size: clamp(24px, 4vw, 34px); margin-bottom: 20px; }
  .talk-timeline { display: grid; gap: 16px; list-style: none; margin: 0; padding: 0 0 0 22px; border-inline-start: 1px solid var(--line); }
  .talk-timeline > li { position: relative; min-width: 0; }
  .talk-timeline > li::before {
    content: '';
    position: absolute;
    inset: 26px auto auto -27px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .talk-timeline > li:nth-child(even)::before { background: var(--secondary); }
  .talk-entry-heading { display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
  .talk-event { margin-bottom: 3px; font-size: 12px; color: var(--muted); }
  .talk-entry-heading h3 { font: 24px/1.25 var(--serif); }
  .talk-entry p { max-width: 65ch; }
  .talk-article {
    position: relative;
    display: grid;
    gap: 3px;
    margin-bottom: 10px;
    padding: 12px 22px 12px 0;
    border-block: 1px solid var(--line);
    text-decoration: none;
  }
  .talk-article > span:first-child, .talk-article small { font-size: 12px; color: var(--muted); }
  .talk-article-arrow { position: absolute; inset: 12px 0 auto auto; color: var(--accent); }
  .talk-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .talk-archive { margin-top: calc(var(--section-gap) + 8px); }
  .talk-archive ul { margin: 0; padding: 0; list-style: none; border-block-start: 1px solid var(--line); }
  .talk-archive a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding-block: 10px;
    border-block-end: 1px solid var(--line);
  }
  @media (max-width: 880px) {
    .talk-intro { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .talk-timeline { padding-inline-start: 13px; }
    .talk-timeline > li::before { inset-inline-start: -18px; }
  }
</style>
