---
import NavIcon from './NavIcon.astro';
import { getPosts, postHref, type PostLanguage } from '../utils/posts';
interface Props {
  series: { slug: string; title: string; part: number };
  lang: PostLanguage;
}
const { series, lang } = Astro.props;
const english = lang === 'en';
const parts = (await getPosts(lang))
  .filter(({ data }) => data.series?.slug === series.slug)
  .sort((a, b) => a.data.series!.part - b.data.series!.part);
---
<details class="post-series">
  <summary>
    <NavIcon name="series" />
    <span>{english ? 'Series' : 'Série'} · {series.title} · {english ? 'Part' : 'Parte'} {series.part}</span>
    <NavIcon name="chevron-down" class="series-chevron" />
  </summary>
  <ol role="list">
    {parts.map(({ data }) => (
      <li value={data.series!.part}>
        {data.series!.part === series.part
          ? <span aria-current="page">{data.title}</span>
          : <a href={postHref(data.canonicalSlug, lang)}>{data.title}</a>}
      </li>
    ))}
  </ol>
</details>
<style>
  .post-series {
    margin: 16px 0 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }
  .post-series[open] { border-radius: var(--radius-card); }
  summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding: 9px 16px;
    border-radius: inherit;
    list-style: none;
    cursor: pointer;
    color: var(--muted-on-panel, var(--muted));
    font-size: var(--text-supporting);
  }
  summary::-webkit-details-marker { display: none; }
  summary:is(:hover, :focus-visible), [open] > summary { color: var(--accent); }
  summary :global(.series-chevron) { inline-size: 14px; block-size: 14px; }
  [open] > summary :global(.series-chevron) { transform: rotate(180deg); }
  ol {
    margin: 0 16px 10px;
    padding: 6px 0 0 26px;
    border-block-start: 1px solid var(--line);
    color: var(--muted-on-panel, var(--muted));
    font-size: var(--text-supporting);
  }
  .post-series:not([open]) > ol { display: none; }
  li > :is(a, span) {
    display: block;
    min-block-size: 44px;
    padding: 10px 8px;
    border-radius: var(--radius-control);
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  li a:is(:hover, :focus-visible), li > [aria-current] { color: var(--accent); }
  li > [aria-current] { font-weight: 600; }
</style>
