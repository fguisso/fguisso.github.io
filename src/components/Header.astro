---
import { localizedPath } from '../utils/i18n';
import LogoWordmark from './LogoWordmark.astro';
import NavIcon from './NavIcon.astro';
import { booksCatalog, primaryNavigation } from '../data/navigation';
import type { PostLanguage } from '../utils/posts';

interface Props { lang?: PostLanguage; alternateHref?: string; compactNavigation?: boolean; }
const { lang = 'pt', alternateHref, compactNavigation = false } = Astro.props;
const english = lang === 'en';
const path = Astro.url.pathname;
const more = [
  { href: booksCatalog, text: english ? 'Books' : 'Livros', external: true },
  { href: '/tags/', text: 'Tags' },
  { href: '/style-guide/', text: english ? 'Style guide' : 'Guia de estilo' },
].map(({ href, text, external }) => ({ href: external ? href : localizedPath(href, lang), text, external }));
const active = (href: string) => path.startsWith(href) ? 'page' : undefined;
const home = localizedPath('/', lang);
const homeLabel = english ? 'Home' : 'Início';
const moreLabel = english ? 'More' : 'Mais';
const languageLabel = english ? 'Language' : 'Idioma';
---

<header class="site-header" data-compact-navigation={compactNavigation || undefined}>
  <nav id="site-navigation" class="site-nav" aria-label={english ? 'Main navigation' : 'Navegação principal'} data-nav-track
    data-mobile-menu={compactNavigation ? 'closed' : undefined}>
    <span class="nav-pill" data-nav-pill aria-hidden="true"></span>
    <span class="nav-progress" data-nav-progress aria-hidden="true">
      <span class="nav-progress-fill image-shimmer"></span>
    </span>
    <button class="nav-launch" type="button" data-nav-launch aria-expanded="false" aria-controls="site-navigation"
      aria-label={english ? 'Open navigation menu' : 'Abrir menu de navegação'}>
      <span aria-hidden="true"><LogoWordmark monogram shineId="menu-launch" /></span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a class="nav-brand" href={home} data-nav-item data-mobile-label={homeLabel} aria-label={'guisso, ' + homeLabel} aria-current={path === home ? 'page' : undefined}>
      <span class="nav-wordmark" aria-hidden="true"><LogoWordmark shineId="header-wordmark" /></span>
      <span class="nav-monogram" aria-hidden="true"><LogoWordmark monogram shineId="header-monogram" /></span>
    </a>
    {primaryNavigation.map(({href, text, icon}) => {
      const destination = localizedPath(href, lang);
      const label = text[lang];
      return (
      <a class="nav-link" data-nav-item data-nav-primary data-mobile-label={label} href={destination} aria-label={label} aria-current={active(destination)}>
        <NavIcon name={icon} />
        <span class="nav-label">{label}</span>
      </a>
      );
    })}
    <details class="nav-disclosure" data-nav-disclosure data-nav-more>
      <summary class:list={['nav-link', { 'nav-active': more.some(({href}) => active(href)) }]} data-nav-item data-mobile-label={moreLabel} aria-label={moreLabel}>
        <NavIcon name="more" />
        <span class="nav-label">{moreLabel}</span>
      </summary>
      <div class="nav-panel">
        {more.map(({href, text, external}) => (
          <a href={href} rel={external ? 'noreferrer' : undefined} aria-current={active(href)}>
            {text}{external && <span aria-hidden="true">↗</span>}
          </a>
        ))}
        <a href="https://wiki.guisso.dev" rel="noreferrer">Wiki ↗</a>
        <button type="button" data-theme-toggle class="theme-toggle" hidden>{english ? 'Theme: dark' : 'Tema: escuro'}</button>
      </div>
    </details>
    <details class="nav-disclosure nav-locale" data-nav-disclosure>
      <summary class="nav-link" data-nav-item data-mobile-label={languageLabel} aria-label={english ? 'EN, select language' : 'PT, selecionar idioma'}>
        <NavIcon name="language" />
        <span class="nav-label">{english ? 'EN' : 'PT'}</span>
      </summary>
      <div class="nav-panel locale-panel">
        {english ? (
          <>
            {alternateHref && <a href={alternateHref} data-language-link hreflang="pt-BR" lang="pt-BR">Português <small aria-hidden="true">PT</small></a>}
            <span aria-current="true">English <small aria-hidden="true">EN</small></span>
          </>
        ) : (
          <>
            <span aria-current="true">Português <small aria-hidden="true">PT</small></span>
            {alternateHref && <a href={alternateHref} data-language-link hreflang="en" lang="en">English <small aria-hidden="true">EN</small></a>}
          </>
        )}
      </div>
    </details>
    <button class="nav-close" type="button" data-nav-close aria-controls="site-navigation"
      aria-label={english ? 'Close navigation menu' : 'Recolher menu de navegação'}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
  </nav>
</header>

{compactNavigation && <noscript>
  <style is:inline>
    [data-compact-navigation] .site-nav[data-mobile-menu] { width: auto; }
    [data-compact-navigation] [data-mobile-menu] > :is(.nav-brand, .nav-link) { display: flex; }
    [data-compact-navigation] [data-mobile-menu] > .nav-disclosure { display: block; }
    [data-compact-navigation] [data-mobile-menu] > .nav-launch { display: none; }
    [data-compact-navigation] [data-mobile-menu] :is(.nav-brand, .nav-link) { width: clamp(38px, 11.6vw, 44px); }
  </style>
</noscript>}

<style>
  .site-header {
    position: sticky;
    top: 18px;
    z-index: 25;
    overflow-anchor: none;
    display: flex;
    justify-content: center;
    margin-top: 22px;
    padding-inline: 12px;
    pointer-events: none;
  }

  .site-nav {
    position: relative;
    display: flex;
    align-items: center;
    padding: 4px;
    gap: 3px;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--panel) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 28px #0002;
    pointer-events: auto;
  }

  .site-nav[data-index-docking] > .nav-pill { opacity: 0; }

  .nav-progress {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    overflow: hidden;
    color: color-mix(in srgb, var(--accent) 65%, var(--line));
    pointer-events: none;
  }

  .nav-progress-fill {
    --shimmer-delay: 16s;
    position: absolute;
    inset: auto 0 1px;
    block-size: 2px;
    background: currentColor;
    transform-origin: left center;
    transform: scaleX(var(--page-progress, 0));
  }

  @media (forced-colors: active) {
    .nav-progress { color: Highlight; forced-color-adjust: none; }
    .nav-progress-fill::after { display: none; }
  }

  .nav-brand, .nav-link {
    align-items: center;
    justify-content: center;
    display: flex;
    gap: 6px;
    min-height: 44px;
    padding: 0 17px;
    border-radius: 999px;
    touch-action: manipulation;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-brand { padding: 0 12px; }
  .nav-launch, .nav-close { display: none; }
  .nav-wordmark { width: 80px; }
  .nav-wordmark :global(svg) { display: block; width: 100%; height: auto; }
  .nav-monogram { display: none; }
  .nav-monogram :global(svg) { display: block; }
  .nav-link { color: var(--muted-on-panel, var(--muted)); font-size: 14px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-link:is(:hover, [aria-current], [data-revealed]), .nav-active, .nav-disclosure[open] summary {
    color: var(--accent);
  }
  .site-nav:not([data-nav-ready]) :is(.nav-link:hover, .nav-link[aria-current], .nav-active, .nav-disclosure[open] summary) {
    background: var(--area);
  }

  .nav-disclosure { z-index: 2; }
  .nav-locale { padding-left: 7px; }
  .nav-locale > summary::before {
    content: '';
    position: absolute;
    inset: 11px auto 11px -5px;
    width: 1px;
    background: var(--line);
  }

  .nav-panel {
    position: absolute;
    inset: calc(100% + 10px) 0 auto auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(290px, calc(100vw - 24px));
    max-height: min(65dvh, 320px);
    overflow: auto;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--panel);
    box-shadow: 0 10px 35px #0003;
  }

  .nav-panel > * {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    min-height: 44px;
    border-radius: var(--radius-control);
    font-size: var(--text-supporting);
    text-decoration: none;
  }

  .nav-panel > :hover, .nav-panel > [aria-current] { background: var(--area); color: var(--accent); }
  .nav-disclosure:not([open]) > .nav-panel { display: none; }
  .nav-panel > [data-nav-primary] { justify-content: flex-start; padding-inline: 12px; }
  .nav-panel > button { grid-column: 1 / -1; }
  .nav-panel > .theme-toggle { color: var(--muted-on-panel, var(--muted)); }
  .locale-panel { width: min(195px, calc(100vw - 24px)); grid-template-columns: minmax(0, 1fr); }
  .locale-panel > * { justify-content: space-between; }

  @media (761px <= width <= 900px) and (min-height: 541px) and (pointer: fine) {
    :global(html[lang="en"]) .nav-link { padding-inline: 11px; }
  }

  @media (max-width: 760px), (pointer: coarse), (max-width: 1024px) and (max-height: 540px) {
    :global(html) { scroll-padding-bottom: calc(75px + env(safe-area-inset-bottom) + var(--compact-nav-extra, 0px)); }
    :global(.site-stage) { padding-bottom: calc(70px + env(safe-area-inset-bottom) + var(--compact-nav-extra, 0px)); }

    .site-header {
      position: fixed;
      inset: auto 0 max(12px, env(safe-area-inset-bottom));
      margin: 0;
    }

    .site-nav { gap: 1px; padding: 3px; }
    .nav-brand, .nav-link { width: clamp(38px, 11.6vw, 44px); padding: 0; }
    .nav-wordmark, .nav-label { display: none; }
    .nav-monogram { display: block; }
    .nav-panel { inset: auto 0 calc(100% + 10px) auto; }
    .site-nav:not([data-mobile-menu]) [data-mobile-label]:focus-visible::after { display: block; }
    @media (hover: hover) {
      .site-nav:not([data-mobile-menu]) [data-mobile-label]:hover::after { display: block; }
    }
  }

  .site-header[data-compact-navigation] {
    position: fixed;
    inset: auto 0 max(12px, env(safe-area-inset-bottom));
    margin: 0;
  }

  [data-mobile-label]::after {
    content: attr(data-mobile-label);
    display: none;
    position: absolute;
    inset: auto auto calc(100% + 8px) 50%;
    translate: -50% 0;
    padding: 4px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--area);
    color: var(--ink);
    font-size: var(--text-caption);
    line-height: 1.4;
    pointer-events: none;
  }
  [data-mobile-menu] [data-mobile-label]:is([data-revealed], :focus-visible)::after { display: block; }
  .site-nav .nav-disclosure[open] [data-mobile-label]::after { display: none; }

  @media (hover: hover) {
    [data-mobile-menu] [data-mobile-label]:hover::after { display: block; }
    [data-mobile-menu]:has([data-mobile-label]:hover) [data-revealed]:not(:hover, :focus-visible)::after { display: none; }
  }

  .site-header:has([data-mobile-menu]) {
    justify-content: flex-end;
    padding-inline: max(8px, env(safe-area-inset-left)) max(8px, env(safe-area-inset-right));
  }
  .site-nav[data-mobile-menu] {
    --dock-size: min(100%, 376px);
    gap: 1px;
    padding: 3px;
    width: 80px;
    margin-inline-end: 0;
    transition: width 260ms ease, margin-inline-end 260ms ease;
  }
  .site-nav[data-mobile-menu] :is(.nav-brand, .nav-link) { padding: 0; }
  [data-mobile-menu] :is(.nav-wordmark, .nav-label) { display: none; }
  [data-mobile-menu] .nav-monogram { display: block; }
  [data-mobile-menu] .nav-panel { inset: auto 0 calc(100% + 10px) auto; }
  .site-nav[data-mobile-menu="open"] {
    width: var(--dock-size);
    margin-inline-end: calc((100% - var(--dock-size)) / 2);
  }
  [data-mobile-menu="closed"] > :not(.nav-launch, .nav-progress) { display: none; }
  [data-mobile-menu="closed"] > .nav-launch, [data-mobile-menu="open"] > .nav-close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0;
    border-radius: 999px;
    touch-action: manipulation;
  }
  .nav-launch { flex: 1; gap: 8px; color: var(--ink); }
  .nav-launch :global(svg) { display: block; }
  [data-mobile-menu="open"] > :is(.nav-brand, .nav-link, .nav-disclosure, .nav-close) {
    width: auto;
    min-width: 0;
    flex: 1 1 0;
  }
  [data-mobile-menu="open"] .nav-disclosure > summary { width: 100%; }
  [data-mobile-menu="open"] > :is(.nav-link, .nav-disclosure, .nav-close) {
    animation: dock-items-in 250ms ease both;
  }
  .nav-close { color: var(--muted-on-panel, var(--muted)); }
  @keyframes dock-items-in { 0%, 40% { opacity: 0; } 100% { opacity: 1; } }

  @media (max-width: 389px) {
    :global(html:has(.site-nav[data-mobile-menu="open"])) { --compact-nav-extra: 45px; }
    .site-nav[data-mobile-menu] { --dock-size: min(100%, 232px); }
    .site-nav[data-mobile-menu="open"] {
      display: grid;
      grid-template-columns: repeat(4, minmax(44px, 1fr));
      border-radius: var(--radius-panel);
    }
    [data-mobile-menu="open"] .nav-locale { padding-inline-start: 0; }
    [data-mobile-menu="open"] .nav-panel {
      inset-inline: 50% auto;
      translate: -50% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav[data-mobile-menu] { transition: none; }
    .site-nav > .nav-pill { transition: none; }
    [data-mobile-menu="open"] > :is(.nav-link, .nav-disclosure, .nav-close) { animation: none; }
  }

  @media print { .site-header { display: none; } }
</style>
