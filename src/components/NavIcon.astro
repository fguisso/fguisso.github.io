---
import type { NavigationIcon } from '../data/navigation';

interface Props { name: NavigationIcon | 'gear' | 'life' | 'series' | 'chevron-down'; class?: string; }
const { name, class: className } = Astro.props;
---

<svg class={className} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'blog' && <path d="M6 3.5h9l3 3V21H6zM14.5 3.5v4H18M9 11h6m-6 4h6" />}
  {name === 'projects' && <path d="M3 6h6l2 2h10v11H3z" />}
  {name === 'talks' && <><rect x="9" y="3.5" width="6" height="11" rx="3" /><path d="M5.5 10.5v1a6.5 6.5 0 0 0 13 0v-1M12 18v3m-3 0h6" /></>}
  {name === 'about' && <><circle cx="12" cy="8" r="3.5" /><path d="M5 20v-1.8a7 7 0 0 1 14 0V20" /></>}
  {name === 'gear' && <><path d="M9.5 5V4h5v1M4 7h16v12H4zM4 12h16M10 11v3m4-3v3" /></>}
  {name === 'life' && <><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="9.5" r="1.5" /><path d="m4 17 4.5-4 3 2.5 4-4 4.5 4.5" /></>}
  {name === 'more' && <><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></>}
  {name === 'language' && <><circle cx="12" cy="12" r="8.6" /><path d="M4 9h16M4 15h16M12 3.4c2.4 2.1 3.8 5.2 3.8 8.6s-1.4 6.5-3.8 8.6c-2.4-2.1-3.8-5.2-3.8-8.6s1.4-6.5 3.8-8.6Z" /></>}
  {name === 'series' && <path d="M7 4h12v13H7zM16 20H4V7m6 1h6m-6 4h6" />}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
</svg>
