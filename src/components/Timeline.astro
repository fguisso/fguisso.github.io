---
interface TimelineItem {
	meta: string;
	role: string;
	variant?: 'warning' | 'danger' | 'success';
}

interface Props {
	items?: TimelineItem[];
	class?: string;
}

const { items = [], class: className } = Astro.props as Props;
const hasSlot = Astro.slots?.has('default');
const hasItems = items.length > 0;
---

<div class:list={['timeline-root', className]}>
	<ol class="timeline-list" role="list">
		{hasItems
			? items.map((item) => (
					item.variant
						? (
							<li class="tli">
								<div class:list={['tldot', `tldot--${item.variant}`]} aria-hidden="true"></div>
								<span class:list={['tltag', `tltag--${item.variant}`]}>{item.meta}</span>
								<p class="tli-role">{item.role}</p>
							</li>
						)
						: (
							<li>
								<div class="dot" aria-hidden="true"></div>
								<div class="entry">
									<p class="meta">{item.meta}</p>
									<p class="role">{item.role}</p>
								</div>
							</li>
						)
			  ))
			: hasSlot && <slot />}
	</ol>
</div>

<style>
  .timeline-list {
    display: grid;
    gap: 20px;
    padding: 16px 16px 16px 36px;
    margin: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }

  .timeline-list li { position: relative; }

  .timeline-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    inset: 13px auto -29px -17px;
    width: 1px;
    background: var(--line);
  }

  .dot, .tldot {
    position: absolute;
    inset: 9px auto auto -20px;
    z-index: 1;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--marker, var(--accent));
  }

  .meta, .tltag { margin: 0 0 3px; font-size: var(--text-caption); color: var(--muted); }
  .role, .tli-role { margin: 0; color: var(--ink); }
  .tltag {
    display: inline-block;
    padding: 1px 7px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--marker, var(--muted));
  }

  .tldot--warning, .tltag--warning { --marker: var(--guide-warning, light-dark(#795615, #ebc582)); }
  .tldot--danger, .tltag--danger { --marker: var(--guide-danger, light-dark(#922e43, #f4a3ae)); }
  .tldot--success, .tltag--success { --marker: var(--accent); }
</style>
