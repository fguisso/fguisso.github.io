---
import { localizedPath } from '../utils/i18n';
import type { PostLanguage } from '../utils/posts';

interface Props { lang: PostLanguage; }
const { lang } = Astro.props;
const english = lang === 'en';
---

<footer class="site-footer shell">
  <div>
    <a class="footer-signature" href={localizedPath('/', lang)}>guisso.dev</a>
    <p>{english ? 'Good security comes with the code.' : 'Segurança boa vem junto com o código.'}</p>
  </div>
  <div class="footer-links">
    <a href={localizedPath('/style-guide/', lang)}>{english ? 'Style guide' : 'Guia de estilo'}</a>
    <a href={localizedPath('/rss.xml', lang)}>RSS</a>
  </div>
</footer>
