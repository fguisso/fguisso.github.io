---
// Breakdown.astro
// Displays any string broken into labeled, colored segments.
// Works for URLs, commands, regex, schemas, or any string anatomy.
//
// Usage:
// <Breakdown parts={[
//   { text: 'http://', label: 'protocol', color: '#c084fc' },
//   { text: 'google.com', label: 'host', sub: 'domínio', color: '#00ff7f' },
// ]} />

interface Part {
  text:   string;
  label:  string;
  sub?:   string;
  color:  string;
}

interface Props {
  lang?: 'pt' | 'en';
  parts: Part[];
}

const { parts, lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'pt' } = Astro.props;
---

<div class="bd-row" tabindex="0" role="group" aria-label={lang === 'en' ? 'Example segments and labels' : 'Trechos e rótulos do exemplo'}>
  {parts.map((p) => (
    <div class="bd-seg" style={`--c:${p.color}`}>
      <div class="bd-text">{p.text}</div>
      <div class="bd-line" aria-hidden="true"></div>
      <div class="bd-meta">
        <span class="bd-label">{p.label}</span>
        {p.sub && <span class="bd-sub">{p.sub}</span>}
      </div>
    </div>
  ))}
</div>

<style>
  .bd-row {
    display: flex;
    align-items: flex-start;
    gap: 2px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 14px;
    margin: 12px 0 0;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .bd-seg {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: default;
  }

  .bd-text {
    background: color-mix(in srgb, var(--c) 8%, var(--page));
    color: var(--ink);
    font-family: ui-monospace, monospace;
    font-size: .9rem;
    font-weight: 500;
    padding: 5px 9px;
    border: 1px solid color-mix(in srgb, var(--c) 48%, var(--line));
    border-radius: 6px;
    white-space: nowrap;
  }

  .bd-line {
    width: 1px;
    height: .9rem;
    background: var(--c);
    opacity: .35;
    flex-shrink: 0;
  }

  .bd-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .1rem;
  }

  .bd-label {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .bd-sub {
    font-family: var(--sans);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
