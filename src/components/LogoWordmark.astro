          <path transform="translate(405.48 0)" d="M 67.68 4.75 C 54.22 4.75 42.4 1.88 32.21 -3.86 C 22.02 -9.6 14.25 -17.71 8.91 -28.2 L 27.01 -37.11 C 34.34 -21.47 48.68 -13.66 70.05 -13.66 C 80.35 -13.66 88.86 -15.54 95.59 -19.3 C 102.31 -23.05 105.68 -28.89 105.68 -36.81 C 105.68 -44.92 102.96 -50.96 97.52 -54.92 C 92.07 -58.88 82.52 -61.45 68.87 -62.64 C 49.87 -64.22 36.27 -68.47 28.05 -75.4 C 19.84 -82.33 15.73 -91.53 15.73 -103.01 C 15.73 -115.87 20.38 -125.86 29.68 -132.99 C 38.98 -140.11 51.75 -143.68 67.98 -143.68 C 95.49 -143.68 114.19 -132.79 124.08 -111.02 L 105.98 -102.12 C 102.61 -110.03 97.71 -115.87 91.28 -119.63 C 84.85 -123.39 76.59 -125.27 66.5 -125.27 C 56.2 -125.27 48.34 -123.39 42.89 -119.63 C 37.45 -115.87 34.73 -110.53 34.73 -103.6 C 34.73 -97.07 37.65 -91.78 43.49 -87.72 C 49.33 -83.66 59.37 -81.04 73.62 -79.85 C 91.23 -78.27 104.34 -73.96 112.95 -66.94 C 121.56 -59.91 125.86 -50.66 125.86 -39.18 C 125.86 -29.88 123.19 -21.92 117.85 -15.29 C 112.51 -8.66 105.38 -3.66 96.48 -0.3 C 87.57 3.07 77.97 4.75 67.68 4.75 Z M 67.68 4.75" />
          <path transform="translate(543.22 0)" d="M 67.68 4.75 C 54.22 4.75 42.4 1.88 32.21 -3.86 C 22.02 -9.6 14.25 -17.71 8.91 -28.2 L 27.01 -37.11 C 34.34 -21.47 48.68 -13.66 70.05 -13.66 C 80.35 -13.66 88.86 -15.54 95.59 -19.3 C 102.31 -23.05 105.68 -28.89 105.68 -36.81 C 105.68 -44.92 102.96 -50.96 97.52 -54.92 C 92.07 -58.88 82.52 -61.45 68.87 -62.64 C 49.87 -64.22 36.27 -68.47 28.05 -75.4 C 19.84 -82.33 15.73 -91.53 15.73 -103.01 C 15.73 -115.87 20.38 -125.86 29.68 -132.99 C 38.98 -140.11 51.75 -143.68 67.98 -143.68 C 95.49 -143.68 114.19 -132.79 124.08 -111.02 L 105.98 -102.12 C 102.61 -110.03 97.71 -115.87 91.28 -119.63 C 84.85 -123.39 76.59 -125.27 66.5 -125.27 C 56.2 -125.27 48.34 -123.39 42.89 -119.63 C 37.45 -115.87 34.73 -110.53 34.73 -103.6 C 34.73 -97.07 37.65 -91.78 43.49 -87.72 C 49.33 -83.66 59.37 -81.04 73.62 -79.85 C 91.23 -78.27 104.34 -73.96 112.95 -66.94 C 121.56 -59.91 125.86 -50.66 125.86 -39.18 C 125.86 -29.88 123.19 -21.92 117.85 -15.29 C 112.51 -8.66 105.38 -3.66 96.48 -0.3 C 87.57 3.07 77.97 4.75 67.68 4.75 Z M 67.68 4.75" />
