        </>
      )}
    </g>
    <polygon points="60.34 198.02 84.8 150.91 107.45 198.02" />
    {!monogram && <polygon points="741.17 161.02 765.63 208.13 788.28 161.02" />}
  </g>

  {shineId && <use class="logo-shine" href={'#' + shapeId} fill="white" mask={'url(#' + maskId + ')'} aria-hidden="true" />}
</svg>

<style>
  .logo-wordmark--animated { color: #9b9b9b; }
  :global(html:is([data-tema=claro], [data-tema=areia])) .logo-wordmark--animated { color: #5f5f5f; }
  .logo-shine { pointer-events: none; }

  .logo-shine-band {
    transform: translateX(calc(-1 * var(--shine-travel)));
    animation: logo-shine-sweep 70s 4s infinite;
  }

  @keyframes logo-shine-sweep {
    0%, 5%, 10% {
      transform: translateX(calc(-1 * var(--shine-travel)));
      animation-timing-function: linear;
    }
    4%, 9%, 14%, 100% {
      transform: translateX(var(--shine-travel));
      animation-timing-function: steps(1, jump-end);
    }
  }

  @media (prefers-reduced-motion: reduce), print {
    .logo-shine { display: none; }
  }
</style>
