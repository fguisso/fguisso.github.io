      {!monogram && (
        <>
          <path transform="translate(166.53 0)" d="M 140.71 -138.93 L 140.71 0 L 120.52 0 L 120.52 -23.16 C 115.77 -14.25 109.49 -7.37 101.67 -2.52 C 93.86 2.32 84.8 4.75 74.51 4.75 C 64.81 4.75 55.86 2.77 47.64 -1.19 C 39.43 -5.14 32.9 -10.98 28.05 -18.7 C 23.2 -26.42 20.78 -35.52 20.78 -46.01 L 20.78 -138.93 L 40.96 -138.93 L 40.96 -54.92 C 40.96 -27.41 53.23 -13.66 77.77 -13.66 C 92.02 -13.66 102.71 -18.7 109.84 -28.79 C 116.96 -38.89 120.52 -52.45 120.52 -69.46 L 120.52 -138.93 Z M 140.71 -138.93" />
