---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  monogram?: boolean;
  shineId?: string;
}

const { monogram = false, shineId, class: className, ...attributes } = Astro.props;
const [x, y, width, height] = monogram ? [14, 105, 141, 207] : [0, 0, 849.6, 329.92];
const shapeId = shineId && shineId + '-shape';
const bandId = shineId && shineId + '-band';
const maskId = shineId && shineId + '-mask';
const centerX = x + width / 2;
const centerY = y + height / 2;
const sweepDistance = (width + height) / 2 + width * 0.4;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={[x, y, width, height].join(' ')}
  class:list={['logo-wordmark', { 'logo-wordmark--animated': shineId }, className]}
  role="img"
  aria-label={monogram ? 'g' : 'guisso'}
  fill="currentColor"
  width={monogram ? 20 : 168}
  height={monogram ? 20 : 65}
  {...attributes}
>
  {shineId && (
    <defs>
      <linearGradient
        id={bandId}
        gradientUnits="userSpaceOnUse"
        x1={x}
        y1={centerY}
        x2={x + width}
        y2={centerY}
        gradientTransform={`rotate(-45 ${centerX} ${centerY})`}
      >
        <stop offset="24%" stop-color="white" stop-opacity="0" />
        <stop offset="50%" stop-color="white" />
        <stop offset="76%" stop-color="white" stop-opacity="0" />
      </linearGradient>
      <mask id={maskId} maskUnits="userSpaceOnUse" x={x} y={y} width={width} height={height}>
        <rect
          class="logo-shine-band"
          x={x - sweepDistance}
          y={y}
          width={width + 2 * sweepDistance}
          height={height}
          fill={'url(#' + bandId + ')'}
          style={`--shine-travel: ${sweepDistance}px`}
        />
      </mask>
    </defs>
  )}

