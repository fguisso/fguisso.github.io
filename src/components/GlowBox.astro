---
import type { HTMLAttributes } from 'astro/types';

type Accent = 'accent' | 'secondary' | 'highlight';
type Padding = 'snug' | 'normal' | 'relaxed';

interface Props extends HTMLAttributes<'div'> {
	accent?: Accent;
	padding?: Padding;
}

const { accent, padding = 'normal', class: className, ...rest } = Astro.props as Props;
const classes = [
	'glow-box',
	accent && `glow-box--${accent}`,
	{
		'glow-box--snug': padding === 'snug',
		'glow-box--relaxed': padding === 'relaxed',
	},
	className,
];
---

<div class:list={classes} {...rest}>
	<slot />
</div>

<style>
	.glow-box {
		min-width: 0;
		padding: 20px;
		border: 1px solid var(--box-line, var(--line));
		border-radius: 18px;
	}
	.glow-box--accent { --box-line: color-mix(in srgb, var(--accent) 48%, var(--line)); }
	.glow-box--secondary, .glow-box--highlight { --box-line: color-mix(in srgb, var(--secondary) 48%, var(--line)); }
	.glow-box--snug { padding: 14px; }
	.glow-box--relaxed { padding: clamp(20px, 4vw, 32px); }
	.glow-box > :global(:last-child) { margin-block-end: 0; }
</style>
