---
interface Props {
  title?: string;
  variant?: 'info' | 'warning' | 'success' | 'danger';
  icon?: string;
}

const { title = 'Nota', variant = 'info', icon } = Astro.props;
---

<div class:list={['callout', 'callout--' + variant]}>
  <p class="title">
    {Astro.slots.has('icon') ? <span aria-hidden="true"><slot name="icon" /></span> : icon && <span class="article-emoji" aria-hidden="true">{icon}</span>}
    {title}
  </p>
  <div class="body"><slot /></div>
</div>

<style>
  .callout {
    --callout-ink: var(--secondary);
    min-width: 0;
    padding: 16px;
    border: 1px solid color-mix(in srgb, var(--callout-ink) 42%, var(--line));
    border-radius: var(--radius-panel);
  }
  .callout--success { --callout-ink: var(--accent); }
  .callout--warning { --callout-ink: var(--guide-warning, light-dark(#795615, #ebc582)); }
  .callout--danger { --callout-ink: var(--guide-danger, light-dark(#922e43, #f4a3ae)); }
  .title { display: flex; align-items: center; gap: 8px; margin: 0 0 6px; font-weight: 600; color: var(--callout-ink); }
  .title > span { display: inline-flex; }
  .body :global(p:last-child) { margin-bottom: 0; }
</style>
