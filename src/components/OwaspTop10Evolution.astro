---
import GlowButton from './GlowButton.astro';
import OwaspPill from './OwaspPill.astro';

interface Props {
	autoPlay?: boolean;
	lineDurationMs?: number;
	replayDelayMs?: number;
	class?: string;
	locale?: 'pt' | 'en';
}

const { autoPlay = false, lineDurationMs = 420, replayDelayMs = 520, class: className, locale = 'pt' } = Astro.props;
const english = locale === 'en';
const connectionLabel = english ? 'Show connections' : 'Mostrar conexões';

type Item = { code: string; label: string };
type RowKind = 'new' | 'down' | 'merge';
type ItemWithBadge = Item & {
	rowKind?: RowKind;
};

const left2021: ItemWithBadge[] = [
	{ code: 'A01', label: 'Broken Access Control' },
	{ code: 'A02', label: 'Cryptographic Failures', rowKind: 'down' },
	{ code: 'A03', label: 'Injection', rowKind: 'down' },
	{ code: 'A04', label: 'Insecure Design', rowKind: 'down' },
	{ code: 'A05', label: 'Security Misconfiguration' },
	{ code: 'A06', label: 'Vulnerable and Outdated Components', rowKind: 'merge' },
	{ code: 'A07', label: 'Identification and Authentication Failures' },
	{ code: 'A08', label: 'Software and Data Integrity Failures' },
	{ code: 'A09', label: 'Security Logging and Monitoring Failures' },
	{
		code: 'A10',
		label: 'Server-Side Request Forgery (SSRF)',
		rowKind: 'merge',
	},
];

const right2025: ItemWithBadge[] = [
	{ code: 'A01', label: 'Broken Access Control', rowKind: 'merge' },
	{ code: 'A02', label: 'Security Misconfiguration' },
	{ code: 'A03', label: 'Software Supply Chain Failures', rowKind: 'new' },
	{ code: 'A04', label: 'Cryptographic Failures' },
	{ code: 'A05', label: 'Injection' },
	{ code: 'A06', label: 'Insecure Design' },
	{ code: 'A07', label: 'Authentication Failures' },
	{ code: 'A08', label: 'Software or Data Integrity Failures' },
	{ code: 'A09', label: 'Security Logging & Alerting Failures' },
	{ code: 'A10', label: 'Mishandling of Exceptional Conditions', rowKind: 'new' },
];

const connections = [
	{ from: '2021-A10', to: '2025-A01', kind: 'merge' },
	{ from: '2021-A05', to: '2025-A02', kind: 'same' },
	{ from: '2021-A06', to: '2025-A03', kind: 'merge' },
	{ from: '2021-A02', to: '2025-A04', kind: 'down' },
	{ from: '2021-A03', to: '2025-A05', kind: 'down' },
	{ from: '2021-A04', to: '2025-A06', kind: 'down' },
	{ from: '2021-A07', to: '2025-A07', kind: 'same' },
	{ from: '2021-A08', to: '2025-A08', kind: 'same' },
	{ from: '2021-A09', to: '2025-A09', kind: 'same' },
];
const labelFor = (code: string, items: Item[]) => {
	const id = code.slice(5);
	return id + ' · ' + items.find(item => item.code === id)!.label;
};
---

<owasp-top10-map
	class:list={['top10-map', className]}
	data-connections={JSON.stringify(connections)}
	data-autoplay={autoPlay ? 'true' : 'false'}
	data-line-duration={String(lineDurationMs)}
	data-replay-delay={String(replayDelayMs)}
	data-replay-label={english ? 'Replay connections' : 'Repetir animação das conexões'}
>
	<div class="top10-map__actions">
		<GlowButton
			variant="accent"
			size="sm"
			data-start-anim
			hidden
			aria-label={connectionLabel}
			title={connectionLabel}
			class="top10-map__play-btn"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8 6v12l10-6-10-6z" fill="currentColor"></path>
			</svg>
		</GlowButton>
		<details class="top10-map__connections">
			<summary>{english ? 'Read the connections' : 'Ler as conexões'}</summary>
			<div>
				<table>
					<thead><tr><th scope="col">2021</th><th scope="col">2025</th></tr></thead>
					<tbody>{connections.map(({ from, to }) => (
						<tr><td>{labelFor(from, left2021)}</td><td>{labelFor(to, right2025)}</td></tr>
					))}</tbody>
				</table>
			</div>
		</details>
	</div>
	<div class="top10-map__canvas" data-canvas>
		<div class="top10-map__table-wrap" data-side="left" aria-label="OWASP Top 10 2021">
			<div class="top10-map__table-shell">
				<table class="top10-map__table" aria-label="OWASP Top 10 2021">
					<thead>
						<tr>
							<th scope="col" class="top10-map__head-cell top10-map__head-cell--code">2021</th>
							<th scope="col" class="top10-map__head-cell">{english ? 'Category' : 'Categoria'}</th>
						</tr>
					</thead>
					<tbody>
						{left2021.map((item) => (
							<tr
								class="top10-map__row"
								data-node={`2021-${item.code}`}
								data-row-kind={item.rowKind ?? ''}
							>
								<td class="top10-map__code">{item.code}</td>
								<td class="top10-map__label-cell">
									<div data-row-copy><span class="top10-map__label">{item.label}</span></div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<div class="top10-map__lane" aria-hidden="true"></div>

		<div class="top10-map__table-wrap" data-side="right" aria-label="OWASP Top 10 2025">
			<div class="top10-map__table-shell">
				<table class="top10-map__table" aria-label="OWASP Top 10 2025">
					<thead>
						<tr>
							<th scope="col" class="top10-map__head-cell top10-map__head-cell--code">2025</th>
							<th scope="col" class="top10-map__head-cell">{english ? 'Category' : 'Categoria'}</th>
						</tr>
					</thead>
					<tbody>
						{right2025.map((item) => (
							<tr
								class="top10-map__row"
								data-node={`2025-${item.code}`}
								data-row-kind={item.rowKind ?? ''}
							>
								<td class="top10-map__code">{item.code}</td>
								<td class="top10-map__label-cell">
									<div data-row-copy>
										<span class="top10-map__label">{item.label}</span>
										{item.rowKind === 'new' && <span class="top10-map__new-pill"><OwaspPill variant="new">{english ? 'New' : 'Nova'}</OwaspPill></span>}
									</div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<svg class="top10-map__arrows" data-arrows viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
	</div>
</owasp-top10-map>

<script>
  type Connection = { from: string; to: string; kind: string };

  class OwaspTop10Map extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const canvas = this.querySelector<HTMLElement>('[data-canvas]')!;
      const svg = this.querySelector<SVGSVGElement>('[data-arrows]')!;
      const button = this.querySelector<HTMLButtonElement>('[data-start-anim]')!;
      const rows = new Map(Array.from(this.querySelectorAll<HTMLTableRowElement>('[data-node]'), row => [row.dataset.node, row]));
      const sourceRows = Array.from(this.querySelectorAll<HTMLTableRowElement>('[data-side="left"] [data-node]'));
      const targetRows = Array.from(this.querySelectorAll<HTMLTableRowElement>('[data-side="right"] [data-node]'));
      const rowPairs = sourceRows.map((source, index) => {
        const target = targetRows[index];
        return { source, target, sourceCopy: source.querySelector('[data-row-copy]')!, targetCopy: target.querySelector('[data-row-copy]')! };
      });
      const duration = Math.max(180, Number(this.dataset.lineDuration) || 420);
      const stagger = Math.floor(duration * .78);
      const replayDelay = Math.max(0, Number(this.dataset.replayDelay) || 0);

      const connections: Connection[] = JSON.parse(this.dataset.connections ?? '[]');
      const edges = connections.map(({ from, to, kind }) => {
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('pathLength', '1');
        path.setAttribute('data-kind', kind);
        path.setAttribute('class', 'top10-map__edge');
        svg.append(path);
        return { path, from: rows.get(from)!, to: rows.get(to)! };
      });
      const linkedRows = new Set(edges.map(edge => edge.to));
      const unlinkedRows = targetRows.filter(row => !linkedRows.has(row));
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const timers: number[] = [];
      let started = false;

      const drawGeometry = () => {
        // Measure the text inside each cell so paired rows can grow and shrink together.
        const cell = getComputedStyle(sourceRows[0].cells[1]);
        const inset = parseFloat(cell.paddingTop) + parseFloat(cell.paddingBottom) + 1;
        const heights = rowPairs.map(({ sourceCopy, targetCopy }) =>
          Math.ceil(Math.max(sourceCopy.getBoundingClientRect().height, targetCopy.getBoundingClientRect().height) + inset),
        );
        rowPairs.forEach(({ source, target }, index) => {
          const height = `${heights[index]}px`;
          source.style.height = target.style.height = height;
        });

        const bounds = canvas.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;
        svg.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`);

        for (const { path, from, to } of edges) {
          const source = from.getBoundingClientRect();
          const target = to.getBoundingClientRect();
          const x1 = source.right - bounds.left + 5;
          const x2 = target.left - bounds.left - 5;
          const y1 = source.top + source.height / 2 - bounds.top;
          const y2 = target.top + target.height / 2 - bounds.top;
          const width = x2 - x1;
          const longJump = Math.abs(y2 - y1) > 4 * source.height;
          const c1 = x1 + width * (longJump ? .20 : .55);
          const c2 = x1 + width * (longJump ? .32 : .45);
          path.setAttribute('d', `M ${x1} ${y1} C ${c1} ${y1}, ${c2} ${y2}, ${x2} ${y2}`);
        }
      };

      const reset = () => {
        timers.splice(0).forEach(timer => window.clearTimeout(timer));
        for (const { path } of edges) {
          path.getAnimations().forEach(animation => animation.cancel());
          path.style.visibility = 'hidden';
        }
        for (const row of targetRows) delete row.dataset.lit;
      };

      const play = () => {
        reset();
        drawGeometry();
        const delay = started ? replayDelay : 0;
        started = true;
        button.setAttribute('aria-label', this.dataset.replayLabel!);
        button.title = this.dataset.replayLabel!;

        const revealEdge = (edge: typeof edges[number]) => {
          edge.path.style.visibility = '';
          edge.to.dataset.lit = 'true';
        };

        if (reducedMotion.matches) {
          edges.forEach(revealEdge);
          for (const row of unlinkedRows) row.dataset.lit = 'true';
          return;
        }

        edges.forEach((edge, index) => {
          timers.push(window.setTimeout(() => {
            edge.path.style.visibility = '';
            const animation = edge.path.animate(
              [{ strokeDashoffset: '1' }, { strokeDashoffset: '0' }],
              { duration, easing: 'ease-in-out', fill: 'both' },
            );
            animation.onfinish = () => revealEdge(edge);
          }, delay + index * stagger));
        });
        unlinkedRows.forEach((row, index) => {
          timers.push(window.setTimeout(() => {
            row.dataset.lit = 'true';
          }, delay + (edges.length - 1) * stagger + duration + 140 + index * 90));
        });
      };

      reset();
      drawGeometry();
      this.dataset.ready = '';
      const observer = new ResizeObserver(drawGeometry);
      observer.observe(canvas);
      for (const { sourceCopy, targetCopy } of rowPairs) {
        observer.observe(sourceCopy);
        observer.observe(targetCopy);
      }
      button.hidden = false;
      button.addEventListener('click', play);
      const frame = this.dataset.autoplay === 'true' ? requestAnimationFrame(play) : undefined;
      this.cleanup = () => {
        if (frame !== undefined) cancelAnimationFrame(frame);
        button.removeEventListener('click', play);
        observer.disconnect();
        reset();
        for (const { path } of edges) path.remove();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('owasp-top10-map')) customElements.define('owasp-top10-map', OwaspTop10Map);
</script>

<style>
  .top10-map {
    --map-warning: var(--guide-warning, light-dark(#795615, #ebc582));
    --map-danger: var(--guide-danger, light-dark(#922e43, #f4a3ae));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    container-type: inline-size;
  }

  .top10-map__actions { display: flex; align-items: flex-start; gap: 12px; }
  .top10-map__actions .top10-map__connections { flex: 1; min-width: 0; margin: 0; }
  .top10-map__connections summary { width: fit-content; min-height: 44px; padding-block: 10px; cursor: pointer; color: var(--ink); font: 14px/24px var(--sans); }
  .top10-map__connections table { width: 100%; table-layout: fixed; border-collapse: collapse; font: 13px/1.5 var(--sans); }
  .top10-map__connections :is(th, td) { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: start; vertical-align: top; overflow-wrap: anywhere; }
  .top10-map__actions .top10-map__play-btn { flex: 0 0 44px; padding: 0; }
  .top10-map__play-btn svg { width: 18px; height: 18px; }

  .top10-map__canvas {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(2rem, 14cqi, 8rem) minmax(0, 1fr);
    gap: 4px;
    align-items: start;
  }

  .top10-map__table-wrap { min-width: 0; }
  .top10-map__table-shell { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-panel); }
  .top10-map__table { width: 100%; table-layout: fixed; border-collapse: collapse; }

  .top10-map__head-cell {
    padding: 9px 8px;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
    color: var(--muted-on-panel, var(--muted));
    text-align: left;
    font-size: 12px;
    font-weight: 600;
  }
  .top10-map__head-cell--code { width: 52px; text-align: center; }

  .top10-map__row td {
    height: 48px;
    padding: 5px 8px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--row-kind, var(--page)) 6%, var(--page));
    vertical-align: middle;
    transition: background-color 220ms ease, color 220ms ease;
  }
  .top10-map__row:last-child td { border-bottom: 0; }
  .top10-map__row[data-row-kind='new'] { --row-kind: var(--accent); }
  .top10-map__row[data-row-kind='down'] { --row-kind: var(--map-danger); }
  .top10-map__row[data-row-kind='merge'] { --row-kind: var(--map-warning); }
  .top10-map__row[data-lit='true'] td { background: color-mix(in srgb, var(--row-kind, var(--secondary)) 12%, var(--page)); }
  [data-ready] [data-side='right'] .top10-map__row:not([data-lit]) td { background: var(--page); }
  [data-ready] [data-side='right'] .top10-map__row:not([data-lit]) .top10-map__label { color: var(--muted); }

  .top10-map__label { color: var(--ink); font-size: 12px; line-height: 1.35; overflow-wrap: anywhere; transition: color 220ms ease; }
  .top10-map__label-cell { line-height: 1.35; }
  .top10-map__code { color: var(--muted-on-panel, var(--muted)); font-size: 12px; text-align: center; }
  .top10-map__new-pill {
    display: inline-block;
    margin-inline-start: 4px;
    white-space: nowrap;
    transition: opacity 180ms ease, translate 220ms ease, visibility 180ms;
  }
  [data-ready] .top10-map__row:not([data-lit]) .top10-map__new-pill {
    visibility: hidden;
    opacity: 0;
    translate: 0 3px;
  }

  .top10-map__arrows { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .top10-map__arrows :global([data-kind='same']) { color: var(--accent); }
  .top10-map__arrows :global([data-kind='down']) { color: var(--map-danger); }
  .top10-map__arrows :global([data-kind='merge']) { color: var(--map-warning); }
  .top10-map__arrows :global(.top10-map__edge) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-linecap: round;
  }

  @container (max-width: 540px) {
    .top10-map__head-cell--code { width: 32px; }
    .top10-map__head-cell, .top10-map__row td { padding-inline: 4px; }
    .top10-map__row td { height: 60px; }
    .top10-map__new-pill { margin-inline-start: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .top10-map__row td, .top10-map__label, .top10-map__new-pill { transition: none; }
  }
</style>
