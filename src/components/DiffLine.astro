---
interface Props {
  lang?: 'pt' | 'en';
	num?: string | number;
	type?: 'add' | 'remove' | 'context' | 'hunk';
	code: string;
	annotation?: string;
}

const { num = '', type = 'context', code, annotation, lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'pt' } = Astro.props;
const hasAnn = !!annotation;
const Row = hasAnn ? 'details' : 'div';
const Line = hasAnn ? 'summary' : 'div';
const sym = type === 'add' ? '+' : type === 'remove' ? '−' : type === 'hunk' ? '' : ' ';
---

<Row class:list={['diff-line', `diff-line--${type}`]}>
	<Line class="diff-line-inner">
		<span class="diff-num">{type !== 'hunk' ? num : ''}</span>
		<span class="diff-sym">{sym}</span>
		<code class="diff-code">{code}</code>
		{hasAnn && <span class="diff-dot" aria-hidden="true" title={lang === 'en' ? 'Click to read annotation' : 'Clique para ver anotação'}>·</span>}
	</Line>
	{hasAnn && (
		<div class="diff-ann">
			<span aria-hidden="true">↳</span> {annotation}
		</div>
	)}
</Row>

<style>
  .diff-line {
    --line-ink: var(--body);
    --line-tint: transparent;
    color: var(--line-ink);
  }

  .diff-line-inner {
    display: grid;
    grid-template-columns: 2rem 1rem minmax(0, 1fr) auto;
    min-height: 28px;
    align-items: center;
    background: var(--line-tint);
  }

  summary.diff-line-inner { cursor: pointer; list-style: none; }
  summary.diff-line-inner::-webkit-details-marker { display: none; }
  summary.diff-line-inner:hover {
    background: color-mix(in srgb, var(--line-ink) 14%, var(--page));
  }

  .diff-num, .diff-sym { text-align: center; user-select: none; }
  .diff-num { color: var(--muted-on-panel, var(--muted)); font-size: 12px; }
  .diff-code { padding-inline: 5px; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
  .diff-dot { padding-inline: 12px; color: var(--secondary); font-size: 18px; }

  .diff-line--add { --line-ink: var(--accent); }
  .diff-line--remove { --line-ink: var(--guide-danger, light-dark(#922e43, #f4a3ae)); }
  .diff-line--hunk { --line-ink: var(--secondary); }
  .diff-line--add, .diff-line--remove, .diff-line--hunk {
    --line-tint: color-mix(in srgb, var(--line-ink) 6%, var(--page));
  }

  .diff-ann {
    padding: 8px 14px;
    padding-inline-start: calc(3rem + 5px);
    border-top: 1px solid var(--line);
    background: var(--panel);
    color: var(--body);
    font: 13px/1.5 var(--sans);
  }

  summary.diff-line-inner:focus-visible { outline-offset: -2px; }
</style>
