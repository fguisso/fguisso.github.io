---
import type { ImageMetadata } from 'astro';
import { withBase } from '../utils/paths';
import '../styles/talk-avatar.css';

interface Props {
	photoSrc?: ImageMetadata | string;
	avatarSrc?: ImageMetadata | string;
	variant?: 'default' | 'corner';
	revealPhoto?: boolean;
}

const {
	photoSrc = '/style-guide/guisso-photo.webp',
	avatarSrc = '/style-guide/guisso-avatar.webp',
	variant = 'default',
	revealPhoto = true,
} = Astro.props as Props;

const photoSrcValue = typeof photoSrc === 'string' ? withBase(photoSrc) : photoSrc.src;
const avatarSrcValue = typeof avatarSrc === 'string' ? withBase(avatarSrc) : avatarSrc.src;
---

<div class="talk-avatar" data-variant={variant} aria-hidden="true">
	<span class="talk-avatar__square talk-avatar__square--primary">
		<img src={avatarSrcValue} alt="" width="54" height="54" loading="lazy" decoding="async" />
	</span>
	{revealPhoto && (
		<span class="talk-avatar__square talk-avatar__square--secondary">
			<img src={photoSrcValue} alt="" width="54" height="54" loading="lazy" decoding="async" />
		</span>
	)}
</div>
