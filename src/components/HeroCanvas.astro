---
import { withBase } from '../utils/paths';

const frame = (suffix = '') => `url('${withBase(`/hero-ascii${suffix}.svg`)}')`;
---
<div class="hero-canvas" data-hero-canvas aria-hidden="true" style={{
  '--hero-dark': frame(),
  '--hero-light': frame('-claro'),
  '--hero-sand': frame('-areia'),
}}>
  <span class="hero-still"></span>
  <canvas data-scene-webgl hidden></canvas>
  <canvas data-scene-output hidden></canvas>
</div>

<script>
  import { heroDefaults, heroInks } from '../data/hero-settings';

  const hero = document.querySelector<HTMLElement>('[data-hero-canvas]');

  if (hero) {
    const loadScene = () => {
      import('../scripts/hero-renderer.js')
        .then(({ mountHeroRenderer }) => {
          const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
          const root = document.documentElement;
          const preferences = () => {
            const theme = root.dataset.tema;
            const ink = theme === 'claro' || theme === 'areia' ? heroInks[theme] : heroInks.escuro;
            return { ...heroDefaults, ...ink, play: heroDefaults.play && !reducedMotion.matches };
          };
          const scene = mountHeroRenderer(hero, preferences());
          const refresh = () => scene.update(preferences());
          reducedMotion.addEventListener('change', refresh);
          new MutationObserver(refresh).observe(root, { attributes: true, attributeFilter: ['data-tema'] });
        })
        .catch(() => {
          // Keep the static illustration when WebGL or the module is unavailable.
        });
    };

    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();

      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(loadScene, { timeout: 1000 });
      } else {
        window.setTimeout(loadScene, 0);
      }
    });

    observer.observe(hero);
  }
</script>

<style>
  .hero-canvas {
    position: relative;
    width: min(305px, 82%);
    aspect-ratio: 1;
    margin: 0;
    pointer-events: none;
  }

  .hero-still {
    position: absolute;
    inset: 0;
    background: var(--hero-dark) center / contain no-repeat;
  }
  :global(html[data-tema=claro]) .hero-still { background-image: var(--hero-light); }
  :global(html[data-tema=areia]) .hero-still { background-image: var(--hero-sand); }
  .hero-canvas[data-ready] .hero-still { display: none; }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  .hero-canvas[data-ready] canvas { visibility: visible; }

  @media (any-hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-canvas[data-ready] { pointer-events: auto; cursor: pointer; }
  }

  @media (any-pointer: coarse) and (prefers-reduced-motion: no-preference) {
    .hero-canvas[data-ready] { pointer-events: auto; touch-action: pan-y pinch-zoom; }
  }

  @media (min-width: 940px) {
    .hero-canvas {
      width: 100%;
      margin: 0;
    }
  }

  @media print {
    .hero-canvas { display: none; }
  }
</style>
