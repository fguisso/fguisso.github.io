---
interface Props {
  lang?: 'pt' | 'en';
	filename?: string;
	tag?: string;
	tagVariant?: 'danger' | 'success' | 'warning' | 'info';
}

const { filename, tag, tagVariant = 'info', lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'pt' } = Astro.props;
const hasHeader = !!(filename || tag);
---

<div class="diff-block">
	{hasHeader && (
		<div class="diff-header">
			{filename && <span class="diff-fname">{filename}</span>}
			{tag && <span class:list={['diff-tag', `diff-tag--${tagVariant}`]}>{tag}</span>}
		</div>
	)}
	<div class="diff-body">
		<slot />
	</div>
	<p class="diff-hint">{lang === 'en' ? 'Select a line marked with · to read its annotation.' : 'Selecione uma linha marcada com · para ver a anotação.'}</p>
</div>

<style>
  .diff-block {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .diff-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }

  .diff-fname { font: 12px/1.5 ui-monospace, monospace; color: var(--muted-on-panel, var(--muted)); overflow-wrap: anywhere; }

  .diff-tag {
    flex-shrink: 0;
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--diff-tag, var(--secondary));
    font: 500 12px/1.5 var(--sans);
  }

  .diff-tag--danger { --diff-tag: var(--guide-danger, light-dark(#922e43, #f4a3ae)); }
  .diff-tag--success { --diff-tag: var(--accent); }
  .diff-tag--warning { --diff-tag: var(--guide-warning, light-dark(#795615, #ebc582)); }

  .diff-body { font: 13px/1.6 ui-monospace, monospace; }
  .diff-hint { margin: 0; padding: 10px 14px; border-top: 1px solid var(--line); color: var(--muted); font: 12px/1.5 var(--sans); }
</style>
