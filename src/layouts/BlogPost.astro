---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ArticleMeta from '../components/ArticleMeta.astro';
import ArticleBentoTitle from '../components/ArticleBentoTitle.astro';
import NavIcon from '../components/NavIcon.astro';
import PostSeries from '../components/PostSeries.astro';
import Site from './Site.astro';
import { archiveHref, postHref, postTagHref, wordCount } from '../utils/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  readingTimeMinutes: number;
  hasTranslation?: boolean;
}

const { post, headings, readingTimeMinutes, hasTranslation } = Astro.props;
const { title, description, pubDate, tags, categories, lang, canonicalSlug, heroImage, series, showDate, showTableOfContents } = post.data;
const english = lang === 'en';
const indexHeadings = headings.filter(({ depth }) => depth === 2);
const showIndex = showTableOfContents !== false && indexHeadings.length > 0;
const alternateHref = hasTranslation ? postHref(canonicalSlug, english ? 'pt' : 'en') : undefined;
const category = categories[0] ?? tags[0];
const archive = archiveHref(lang);
const totalWords = wordCount(post.body);
---
<Site {title} {description} {lang} {alternateHref} postSlug={canonicalSlug}>
  <main id="conteudo" class="article-shell" tabindex="-1">
    <nav class="trail" aria-label={english ? 'Location' : 'Localização'}>
      <a href={archive}>{english ? '← All articles' : '← Todos os artigos'}</a>
    </nav>
    <header class="article-header">
      <ArticleBentoTitle {title} />
      <p class="lead">{description}</p>
      <ArticleMeta {category} date={showDate ? pubDate : undefined} wordCount={totalWords} {readingTimeMinutes} {lang} />
    </header>
    <hr class="article-divider" />
    {showIndex && (
      <aside class="article-index" data-article-index>
        <details class="toc-menu" data-article-toc>
          <summary>
            <NavIcon name="blog" />
            <span>{english ? 'In this article' : 'Neste artigo'}</span>
            <NavIcon name="chevron-down" class="article-toc-chevron" />
          </summary>
          <nav aria-label={english ? 'Article contents' : 'Índice do artigo'}>
            <a href="#conteudo">{english ? 'Top' : 'Começo'}</a>
            {indexHeadings.map(({ slug, text }) => <a href={'#' + slug}>{text}</a>)}
          </nav>
        </details>
      </aside>
    )}
    <div class="article-grid">
      <article class="article-body">
        {heroImage && <Image class="article-cover" src={heroImage} alt="" decoding="async" />}
        {series && <PostSeries {series} {lang} />}
        <div class="prose"><slot /></div>
        <footer class="article-footer">
          {tags.length > 0 && <ul class="tags" role="list" aria-label={english ? 'Topics' : 'Assuntos'}>
            {tags.map(tag => <li><a href={postTagHref(tag, lang)}>#{tag}</a></li>)}
          </ul>}
          <a href={archive}>{english ? 'More articles ↗' : 'Mais anotações ↗'}</a>
        </footer>
      </article>
    </div>
  </main>
</Site>
