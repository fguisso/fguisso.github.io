---
import { getRequestLocale, type LocaleCode } from '../i18n/config';
import Site from './Site.astro';

interface Props {
	title: string;
	description?: string;
	eyebrow?: string;
}

const { title, description, eyebrow, locale: forcedLocale } = Astro.props as Props & {
	locale?: LocaleCode;
};
const lang = forcedLocale ?? getRequestLocale(Astro);
---

<Site {title} {description} {lang}>
	<main id="conteudo" class="reading-shell page-content markdown-page" tabindex="-1">
		<header class="page-intro">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h1>{title}</h1>
			{description && <p class="lead">{description}</p>}
		</header>
		<div class="prose markdown-page__content"><slot /></div>
	</main>
</Site>

<style>
	.markdown-page {
		padding-bottom: 2rem;
	}

	.markdown-page__content {
		margin-top: var(--section-gap);
		max-width: 70ch;
	}
</style>
