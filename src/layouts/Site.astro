---
import { localizedPath } from '../utils/i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/reading.css';
import type { PostLanguage } from '../utils/posts';
import { socialCardPath } from '../utils/social-card-paths';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
  lang?: PostLanguage;
  alternateHref?: string;
  postSlug?: string;
  shareable?: boolean;
  bodyClass?: string;
}
const { title, lang = 'pt', postSlug, shareable = true } = Astro.props;
const english = lang === 'en';
const alternateLang = english ? 'pt' : 'en';
const alternateHref = Astro.props.alternateHref
  ? withBase(Astro.props.alternateHref)
  : postSlug ? undefined : localizedPath(Astro.url.pathname, alternateLang);
const description = Astro.props.description ?? (english
  ? 'Software engineering, security and curiosity with Fernando Guisso.'
  : 'Fernando Guisso, engenharia de software, segurança e curiosidade.');
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const image = new URL(socialCardPath(lang, postSlug), site);
const imageAlt = postSlug ? title : (english
  ? 'Fernando Guisso. Software engineering, security and curiosity.'
  : 'Fernando Guisso. Engenharia de software, segurança e curiosidade.');
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'} data-tema="escuro">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {!shareable && <meta name="robots" content="noindex" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title} · guisso.dev</title><link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {shareable && <>
      <link rel="canonical" href={canonical.href} />
      {alternateHref && <>
        <link rel="alternate" hreflang={english ? 'en' : 'pt-BR'} href={canonical.href} />
        <link rel="alternate" hreflang={english ? 'pt-BR' : 'en'} href={new URL(alternateHref, site).href} />
      </>}
      <meta property="og:type" content={postSlug ? 'article' : 'website'} />
      <meta property="og:site_name" content="guisso.dev" />
      <meta property="og:locale" content={english ? 'en_US' : 'pt_BR'} />
      {alternateHref && <meta property="og:locale:alternate" content={english ? 'pt_BR' : 'en_US'} />}
      <meta property="og:url" content={canonical.href} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:image" content={image.href} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={imageAlt} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={image.href} />
      <meta name="twitter:image:alt" content={imageAlt} />
    </>}
    <link rel="alternate" type="application/rss+xml" href={localizedPath('/rss.xml', lang)} hreflang={english ? 'en' : 'pt-BR'} title={english ? 'guisso.dev (English)' : 'guisso.dev (Português)'} />
    <script is:inline>try{const t=localStorage.getItem('guisso-theme');if(['claro','areia','escuro'].includes(t))document.documentElement.dataset.tema=t}catch{}</script>
  </head>
  <body class={Astro.props.bodyClass}><a class="skip-link" href="#conteudo">{lang === 'en' ? 'Skip to content' : 'Pular para o conteúdo'}</a><Header {lang} {alternateHref} /><div class="site-stage"><slot /><Footer {lang} /></div><script src="../scripts/client.ts"></script></body>
</html>
